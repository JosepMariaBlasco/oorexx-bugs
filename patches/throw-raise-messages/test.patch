Index: ooRexx/base/keyword/RAISE.testGroup
===================================================================
--- a/ooRexx/base/keyword/RAISE.testGroup	(revision 13563)
+++ b/ooRexx/base/keyword/RAISE.testGroup	(working copy)
@@ -478,6 +478,25 @@
   end
 
 
+-- the errors of a SYNTAX code that is not valid name RAISE (THROW has its own)
+::method test_RAISE_SYNTAX_bad_code
+  do code over .array~of("abc", "0", "100", "40.1x")
+    do
+      raise syntax (code)
+      self~fail("no error for" code)
+    catch c = syntax
+      self~assertSame(33.904, c~code, code)
+      self~assertSame("Incorrect expression result following SYNTAX keyword of RAISE instruction.", c~message, code)
+    end
+  end
+  -- an RC with no string value; in a routine of its own, without this
+  -- package's ::OPTIONS (NOSTRING SYNTAX would stop it first)
+  r = .routine~new("nilString", "do; raise syntax (arg(1)); catch c = syntax; return c; end")
+  c = r~call(.RaiseNilString~new)
+  self~assertSame(41.901, c~code)
+  self~assertSame('Value of RAISE instruction SYNTAX expression must be numeric; found "a RAISENILSTRING".', c~message)
+
+
 ::method "test_RAISE_USER"
   self~expectCondition("USER RGF")
   raise UseR rGf
@@ -653,5 +672,10 @@
 ::routine raiseNoValue
   raise user nothing
 
+-- an object whose STRING method returns .nil: requestString gives .nil
+::class RaiseNilString
+::method string
+  return .nil
 
+
