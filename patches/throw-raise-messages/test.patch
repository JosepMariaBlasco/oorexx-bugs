--- an error number that does not exist: 98.941, shown as a CODE (93.9, not 93009)
+-- an error number that does not exist: 98.940 (98.941 for RAISE), shown as a
+-- CODE (93.9, not 93009)
 ::method test_throw_syntax_unknown_code
-  do
-    throw syntax 93.9
-    self~fail("no error for 93.9")
-  catch c = syntax
-    self~assertSame(98.941, c~code)
-    self~assertTrue(c~message~pos('found "93.9".') > 0, c~message)
-    self~assertFalse(c~thrown)
+  do code over .array~of("93.9", "40.999", "1.0")
+    do
+      throw syntax (code)
+      self~fail("no error for" code)
+    catch c = syntax
+      self~assertSame(98.940, c~code, code)
+      self~assertSame("Unknown error number specified on THROW SYNTAX; found" '"'code'".', c~message, code)
+      self~assertFalse(c~thrown, code)
+    end
   end
 
+-- the errors of a SYNTAX code that is not valid name THROW, not RAISE
+::method test_throw_syntax_bad_code
+  do code over .array~of("abc", "0", "100", "40.1x")
+    do
+      throw syntax (code)
+      self~fail("no error for" code)
+    catch c = syntax
+      self~assertSame(33.905, c~code, code)
+      self~assertSame("Incorrect expression result following SYNTAX keyword of THROW instruction.", c~message, code)
+      self~assertFalse(c~thrown, code)
+    end
+  end
+  -- an RC with no string value; in a routine of its own, without this
+  -- package's ::OPTIONS (NOSTRING SYNTAX would stop it first)
+  r = .routine~new("nilString", "do; throw syntax (arg(1)); catch c = syntax; return c; end")
+  c = r~call(.ThrowNilString~new)
+  self~assertSame(41.902, c~code)
+  self~assertSame('Value of THROW instruction SYNTAX expression must be numeric; found "a THROWNILSTRING".', c~message)
