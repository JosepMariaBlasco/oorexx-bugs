Index: ooRexx/base/class/Stream.testGroup
===================================================================
--- a/ooRexx/base/class/Stream.testGroup	(revision 13504)
+++ b/ooRexx/base/class/Stream.testGroup	(working copy)
@@ -2586,6 +2586,49 @@
   return content
 
 
+-- LINEOUT with no string, on a stream with RECLENGTH, completes a record
+-- that has been started, but writes nothing at the start of a record: it
+-- used to write a whole record of blanks there
+::method test_lineout_no_string_reclength
+  f = .TemporaryTestFile~new(, "test_lineout_no_string_reclength")
+  s = .Stream~new(f)
+
+  do rl = 1 to 4
+    do n = 0 to 2 * rl
+      id = "reclength" rl", charout" n
+      start = "C"~copies(n)
+      expected = start || " "~copies((rl - n // rl) // rl)
+
+      -- closing the stream
+      call open
+      self~assertSame(0, s~lineout, id)
+      self~assertSame(expected, written(), id", lineout()")
+
+      -- positioning by line
+      call open
+      self~assertSame(0, s~lineout( , 1), id)
+      self~assertSame(expected, written(), id", lineout(, 1)")
+    end
+  end
+  f~delete
+  return
+
+  open:
+  s~open("write replace binary reclength" rl)
+  if n > 0 then
+    s~charout(start)
+  return
+
+  -- closes the stream and returns what the file has
+  written: procedure expose s f
+  s~close
+  check = .Stream~new(f)
+  check~open("read")
+  content = check~charin(1, check~chars)
+  check~close
+  return content
+
+
 -- HANDLE:n streams lost their handle when they were opened: writing crashed
 -- the interpreter (SIGSEGV), and nothing reached the handle.  In a child
 -- process, so that a crash cannot take the test suite with it.
