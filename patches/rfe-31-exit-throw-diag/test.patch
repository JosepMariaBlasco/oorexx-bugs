+::method TestContextExitThrow
+  -- Throw() from a context exit (RFE #31), with the THROW action of the test
+  -- exits: an ERROR condition, RC 4321, thrown once (tests/exitThrow.rex)
+  program = self~resolveTestProgram('tests/exitThrow.rex')
+
+  -- the exit, the clause that calls it, the description, and the line of the
+  -- clause the condition is thrown at.  An exit called for a clause throws at
+  -- that clause; RXHLT and RXTRC, called after each clause, throw at the clause
+  -- just run (the DO, the first clause of the program).  A CATCH around the
+  -- clause catches the condition
+  cases = .array~new
+  cases~append(.array~of("IOExit", "SAY", "Session I/O Exit", 'when what == "SAY" then say "exitThrow"'))
+  cases~append(.array~of("QueueExit", "PUSH", "Queue Exit", 'when what == "PUSH" then push "exitThrow"'))
+  cases~append(.array~of("FunctionExit", "FUNCTION", "Function Exit", 'when what == "FUNCTION" then x = exitThrowFunction()'))
+  cases~append(.array~of("ScriptingExit", "FUNCTION", "Scripting Function Exit", 'when what == "FUNCTION" then x = exitThrowFunction()'))
+  cases~append(.array~of("ObjectFunctionExit", "FUNCTION", "Object Function Exit", 'when what == "FUNCTION" then x = exitThrowFunction()'))
+  cases~append(.array~of("CommandExit", "COMMAND", "Command Exit", 'when what == "COMMAND" then "exitThrow"'))
+  cases~append(.array~of("NovalueExit", "NOVALUE", "Novalue Exit", 'when what == "NOVALUE" then x = exitThrowVariable'))
+  cases~append(.array~of("ValueExit", "VALUE", "Value Exit", 'when what == "VALUE" then x = value("exitThrow", , "EXITTHROW")'))
+  cases~append(.array~of("HaltExit", "NONE", "Halt Exit", 'do'))
+  cases~append(.array~of("TraceExit", "NONE", "Trace Exit", 'do'))
+  do case over cases
+    tester = .InvocationTester~new
+    tester~exitType = "CONTEXT"
+    tester~send(case[1]"=", "THROW")
+    .stderr~lineout("DIAG before" case[1] case[2])
+    diag = tester~callInstanceProgram(program, .array~of(case[2]))
+    .stderr~lineout("DIAG after" case[1] "->" diag "RC" tester~RC "code" tester~code)
+    self~assertEquals("4321/"case[3]"/1/"case[4], tester~callInstanceProgram(program, .array~of(case[2])), case[1])
+  end
+
+  -- RXINI and RXTER of the program throw before its first clause and after
+  -- its last one: nothing in the program can catch the condition, and
+  -- CallProgram() ends with it
+  do name over .array~of("InitExit", "TermExit")
+    tester = .InvocationTester~new
+    tester~exitType = "CONTEXT"
+    tester~send(name"=", "THROW")
+    .stderr~lineout("DIAG before" name)
+    tester~callInstanceProgram(program, .array~of("NONE"))
+    self~assertEquals(4321, tester~RC, name)
+    self~assertEquals(0, tester~code, name)
+  end
+
 ::method resolveTestProgram
   use arg name
   parse source . . me
