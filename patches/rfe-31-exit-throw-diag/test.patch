+-- Throw() from a context exit (RFE #31): the exit set to THROW throws an
+-- ERROR condition, RC 4321, once.  The DO is the first clause, so that an
+-- RXHLT or RXTRC exit, called after each clause, throws inside the block.
+do
+  use arg what
+  select
+    when what == "SAY" then say "exitThrow"
+    when what == "PUSH" then push "exitThrow"
+    when what == "FUNCTION" then x = exitThrowFunction()
+    when what == "COMMAND" then "exitThrow"
+    when what == "NOVALUE" then x = exitThrowVariable
+    when what == "VALUE" then x = value("exitThrow", , "EXITTHROW")
+    otherwise nop
+  end
+  return "NOT THROWN"
+catch error
+  c = condition("O")
+  -- the clause it was thrown at
+  return c~rc"/"c~description"/"c~thrown"/"sourceline(c~position)~strip
+end
