@@ -1904,6 +1904,44 @@
   self~assertSame("", b.2)
   self~assertSame("Line3", b.3)
 
+-- Throw() (RFE #31, CALL_INTERFACE_VERSION_5_3_0) from a native routine:
+-- thrown as by THROW, through the Rexx routine between, and the native
+-- routine does not go on after the call
+::method TestThrowRoutine01
+  continue = .false
+  do
+    call throwRoutine_oneLevel "USER BOOM", "d1"
+    self~fail("not thrown")
+  catch c = user boom
+    self~assertSame("d1", c~description)
+    self~assertTrue(c~thrown)
+  end
+  do
+    call TestThrow "ERROR", 7
+    self~fail("not thrown")
+  catch c = error
+    self~assertSame(7, c~rc)
+    self~assertTrue(c~thrown)
+  end
+  -- native code must not have continued after the Throw call
+  self~assertFalse(continue)
+
+::method TestThrowRoutine02
+  do
+    call TestThrow "SYNTAX", 88.917, , .array~of(1, 2, 3)
+    self~fail("not thrown")
+  catch c = syntax
+    self~assertSame(88.917, c~code)
+    self~assertTrue(c~thrown)
+  end
+  do
+    call TestThrow "NOTREADY", 1
+    self~fail("no error")
+  catch c = syntax
+    self~assertSame(93.900, c~code)
+    self~assertFalse(c~thrown)
+  end
+
