+-- RFE #31: a condition that a native command handler throws (Throw()) goes
+-- on from caller to caller, as THROW: past the routine that issued the
+-- command, and not only to the issuer, as a condition the handler raises
+::method test_AddCommandEnvironment_throw
+  call TestAddCommandEnvironment "rc-throw", "throw"
+  do
+    call throwCommand_oneLevel "rc-throw", "USER BOOM"
+    self~fail("not thrown")
+  catch c = user boom
+    self~assertTrue(c~thrown)
+    self~assertSame("thrown", c~description)
+  end
+
+::method test_AddCommandEnvironment_throw_redirecting
+  -- ... from a REDIRECTING handler too
+  call TestAddCommandEnvironment "rc-throw-r", "throw-redirecting"
+  do
+    call throwCommand_oneLevel "rc-throw-r", "USER BOOM"
+    self~fail("not thrown")
+  catch c = user boom
+    self~assertTrue(c~thrown)
+    self~assertSame("thrown", c~description)
+  end
+
+::method test_AddCommandEnvironment_throw_error
+  -- ... a thrown ERROR too: it is not the command's ERROR, which stops at
+  -- the issuer; the code that catches it gets its RC
+  call TestAddCommandEnvironment "rc-throw", "throw"
+  rc = "unset"
+  do
+    call throwCommand_oneLevel "rc-throw", "ERROR"
+    self~fail("not thrown")
+  catch c = error
+    self~assertTrue(c~thrown)
+    self~assertSame(7, c~rc)
+    self~assertSame(7, rc)
+  end
+
+::method test_AddCommandEnvironment_throw_uncaught
+  -- ... and uncaught it is error 4.901, as an uncaught THROW (it was ignored)
+  source = .array~of( -
+    "call TestAddCommandEnvironment 'rc-throw', 'throw'", -
+    "address 'rc-throw' 'USER BOOM'", -
+    "say 'went on'", -
+    "::routine TestAddCommandEnvironment external 'LIBRARY orxfunction TestAddCommandEnvironment'")
+  program = .TemporaryTestFile~new(self, self~getName".tmp.rex")~create(source)
+  output = .array~new
+  call issueCmd "rexx" program~quotedName, output
+  self~assertFalse(output~hasItem("went on"), output~makeString)
+  self~assertSame("Error 4.901:  Program interrupted with USER BOOM condition: thrown.", output~lastItem, output~makeString)
+
+::method test_NativeCommandHandler_forward_throw
+  -- ... and when a handler written in Rexx forwards the command to it
+  call TestAddCommandEnvironment "rc-throw", "throw"
+  native = .CommandHandler~handler("rc-throw")
+  .CommandHandler~register("rc-forward", .ForwardingHandler~new(native))
+  do
+    call throwCommand_oneLevel "rc-forward", "USER BOOM"
+    self~fail("not thrown")
+  catch c = user boom
+    self~assertTrue(c~thrown)
+    self~assertSame("thrown", c~description)
+  finally
+    .CommandHandler~deregister("rc-forward")
+  end
+
