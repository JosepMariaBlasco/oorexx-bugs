+-- with a description: error 4.901, which says it
+::method TestThrow07
+  source = .array~of( -
+    "call r", -
+    "::routine r", -
+    "  call TestThrow 'USER NOBODY', , 'from native code'", -
+    "::routine TestThrow external 'LIBRARY orxfunction TestThrow'")
+  output = .array~new
+  program = .TemporaryTestFile~new(self, "api_throw_uncaught_desc.tmp.rex")~create(source)
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame("Error 4.901:  Program interrupted with USER NOBODY condition: from native code.", output~lastItem, output~makeString)
+  self~assertFalse(theRC = 0)
