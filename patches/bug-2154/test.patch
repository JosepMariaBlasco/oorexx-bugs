 ::class environmentEntries.testGroup subclass ooTestCase public
 
@@ -197,7 +198,73 @@
   .debugInput~destination
   self~assertSame(3, a)
 
+-- the line read for interactive debug (.debugInput), PULL and PARSE PULL
+-- (the queue, then .input) and PARSE LINEIN (.input) is the answer of a
+-- LINEIN or PULL method, which can be a Rexx method.  An answer of no value
+-- crashed the interpreter, and a non-string answer to .debugInput was read
+-- as if it were a string.  No value must read as a null string (for the
+-- queue, as an empty queue), and a non-string through its string value.
+-- In a child process, so that a crash cannot take the test suite with it.
+::method test_input_no_value_non_string
+  source = .array~of( -
+    ".traceOutput~destination(.sink~new)", -
+    ".debugInput~destination(.inputSource~new(.nil, 'a=2', '=', 'trace off'))", -
+    "trace ?r", -
+    "a = 1", -
+    "if a = 2 then a = 3", -
+    ".debugInput~destination", -
+    "say '[3]' '[' || a || ']'", -
+    ".debugInput~destination(.inputSource~new(.stringValue~new('b=1'), 'trace off'))", -
+    "b = 0", -
+    "trace ?r", -
+    "nop", -
+    ".debugInput~destination", -
+    "say '[1]' '[' || b || ']'", -
+    ".input~destination(.inputSource~new(.nil, .nil, .stringValue~new('c')))", -
+    "parse linein x; say '[]' '[' || x || ']'", -
+    "pull x; say '[]' '[' || x || ']'", -
+    "pull x; say '[C]' '[' || x || ']'", -
+    ".input~destination", -
+    ".local~stdque = .inputSource~new(.nil, .stringValue~new('e'))", -
+    ".input~destination(.inputSource~new('d'))", -
+    "parse pull x; say '[d]' '[' || x || ']'", -
+    "parse pull x; say '[e]' '[' || x || ']'", -
+    ".input~destination", -
+    "exit", -
+    "-- answers LINEIN and PULL with its items, in order; for a .nil item, or", -
+    "-- when there are no items left, it answers no value", -
+    "::class inputSource", -
+    "::method init", -
+    "  expose items", -
+    "  items = arg(1, 'a')", -
+    "::method linein", -
+    "  expose items", -
+    "  if items~isEmpty then return", -
+    "  item = items~delete(1)", -
+    "  if item~isNil then return", -
+    "  return item", -
+    "::method pull", -
+    "  forward message('LINEIN')", -
+    "-- not a string; its string value is given", -
+    "::class stringValue", -
+    "::method init", -
+    "  expose value", -
+    "  use arg value", -
+    "::method string", -
+    "  expose value", -
+    "  return value", -
+    "::class sink", -
+    "::method lineout", -
+    "  return 0")
+  program = .TemporaryTestFile~new(self, "input_no_value.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(7, output~items, "rexx ended with rc" theRC "after" output~items "lines")
+  do line over output
+    self~assertSame(line~word(1), line~word(2), line)
+  end
 
+
