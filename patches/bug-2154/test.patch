+-- a .debugInput whose LINEIN answers no value advances, like a null line
+::method test_debuginput_no_value
+  .debugInput~destination(.InputSource~new(.nil, "a=2", "=", "trace ?"))
+  self~disableTraceOutput -- .traceOutput~destination(.NullOutput~new)
+  trace ?r
+  a = 1
+  if a = 2 then a = 3
+  .debugInput~destination
+  self~assertSame(3, a)
 
+-- a .debugInput whose LINEIN answers a non-string is read through its
+-- string value (it used to be read as if it were a string); under this
+-- group's ::OPTIONS the conversion raises NOSTRING as a syntax error
+::method test_debuginput_non_string
+  .debugInput~destination(.InputSource~new(.StringValue~new("nop")))
+  self~disableTraceOutput -- .traceOutput~destination(.NullOutput~new)
+  signal on syntax name nostring
+  trace ?r
+  nop
+nostring:
+  trace off
+  .debugInput~destination
+  condition = condition("o")
+  self~assertFalse(condition~isNil, "NOSTRING should have been raised")
+  self~assertSame("98.973", condition~code)
+
+-- PULL and PARSE LINEIN with an .input whose LINEIN answers no value
+-- read a null string
+::method test_input_no_value
+  .input~destination(.InputSource~new(.nil, .nil))
+  pull a
+  parse linein b
+  .input~destination
+  self~assertSame("", a)
+  self~assertSame("", b)
+
+-- a queue whose PULL answers no value is empty: PULL reads from .input
+::method test_queue_no_value
+  queue = .stdque
+  .local~stdque = .InputSource~new(.nil)
+  .input~destination(.ArrayStream~of("a"))
+  pull a
+  .local~stdque = queue
+  .input~destination
+  self~assertSame("A", a)
+
+
