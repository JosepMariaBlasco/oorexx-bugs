+-- answers LINEIN and PULL with its items, in order; for a .nil item, or
+-- when there are no items left, it answers no value
+::class InputSource
+::method init
+  expose items
+  use strict arg ...
+  items = arg(1, "a")
+::method lineIn
+  expose items
+  if items~isEmpty then
+    return
+  item = items~delete(1)
+  if item~isNil then
+    return
+  return item
+::method pull
+  forward message("LINEIN")
+
+-- an object that is not a string, whose string value is given
+::class StringValue
+::method init
+  expose value
+  use strict arg value
+::method string
+  expose value
+  return value
+
+
 ::options all syntax error condition failure condition
