+::method test_untrapped_error_after_set_in_child_process
+  exe = .RexxInfo~executable
+  if exe == .nil then return
+  child = .File~temporaryPath || .File~separator || "cmdhandler-untrapped-" || time("S") || ".rex"
+  s = .stream~new(child); s~open("write replace")
+  s~lineout('.CommandHandler~register("T", .T~new)')
+  s~lineout('address t "X"')
+  s~lineout('::class T subclass CommandHandler')
+  s~lineout('::method command')
+  s~lineout('  use arg command, caller')
+  s~lineout('  caller["x"] = 1')
+  s~lineout('  return 1 / 0')
+  s~close
+  address system '"'exe'" "'child'"' with output stem co. error stem ce.
+  all = ""
+  do k = 1 to ce.0; all ||= ce.k" "; end
+  do k = 1 to co.0; all ||= co.k" "; end
+  call SysFileDelete child
+  self~assertTrue(all~pos("Error 42") > 0, all)
+
