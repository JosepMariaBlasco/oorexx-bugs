+/*----------------------------------------------------------------------------*/
+/* Command environments written in Rexx: .CommandHandler, .CommandContext,    */
+/* and the context's streams (.CommandInput, .CommandOutput).                 */
+/*----------------------------------------------------------------------------*/
+parse source . . fileSpec
+group = .TestGroup~new(fileSpec)
+group~add(.CommandHandler.testGroup)
+if group~isAutomatedTest then
+  return group
+else
+  return group~suite~execute~~print
+
+::requires "ooTest.frm"
+
+
+::class CommandHandler.testGroup subclass ooTestCase public
+
+::method setUp
+  .CommandHandler~register("t", .CHT~new)        -- lower case on purpose
+  .CommandHandler~register("u", .CHU~new)
+
+::method tearDown
+  -- registrations stack: remove every handler written in Rexx a test left
+  do name over "T", "U", "R", "V"
+    do forever
+      handler = .CommandHandler~handler(name)
+      if handler == .nil | handler~isA(.NativeCommandHandler) then leave
+      .CommandHandler~deregister(name)
+    end
+  end
+
