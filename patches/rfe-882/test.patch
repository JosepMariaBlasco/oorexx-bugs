+  self~assertTrue(envs["T"]~isA(.CHT))
+  self~assertTrue(envs["U"]~isA(.CHU))
+  .CommandHandler~deregister("u")
+  self~assertFalse(.CommandHandler~environments~hasIndex("U"))
+  do name over envs~allIndexes
+    self~assertTrue(envs[name]~isA(.CommandHandler))     -- natives too: no strings
+  end
