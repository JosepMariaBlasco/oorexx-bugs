+-- helpers -----------------------------------------------------------------------
+
+::routine inProcedure
+  local = "x"
+  address t "SET local local"
+  return local
+
+::routine syntaxAfter
+  use arg verb
+  signal on syntax name got
+  i.0 = 1; i.1 = "a"
+  address t verb with input stem i. output stem o.
+  return "none"
+got:
+  return condition("O")~code
+
+::routine tracebackItems
+  use arg what
+  signal on syntax name got
+  if what == "DIRECT" then x = 1 / 0
+  address t what
+  return 0
+got:
+  return condition("O")~traceback~items
+
+::routine syntaxCode
+  use arg msg
+  signal on syntax name got
+  msg~send
+  return "none"
+got:
+  return condition("O")~code
+
+::routine staleCode
+  use arg msg
+  signal on syntax name got
+  msg~send
+  return "none"
+got:
+  return condition("O")~code
+
+::routine haltSignalOn
+  use arg how
+  signal on halt name got
+  signal on syntax name syn
+  address t "HALT" how
+  nop
+  return "went on, rc" rc
+got:
+  return "HALT"
+syn:
+  return "SYNTAX" condition("O")~code
+
+::routine haltCallOn
+  use arg how
+  r = "none"
+  call on halt name got
+  signal on syntax name syn
+  address t "HALT" how
+  nop
+  nop
+  if r == "none" then r = "went on, rc" rc
+  return r
+got:
+  r = "HALT" rc
+  return
+syn:
+  return "SYNTAX" condition("O")~code
+
+::routine haltUntrapped
+  use arg how
+  signal on syntax name syn
+  address t "HALT" how
+  nop
+  return "went on, rc" rc
+syn:
+  return condition("O")~code
+
+
+-- the handlers ----------------------------------------------------------------
+
+::class CHT subclass CommandHandler
+::method command
+  use arg cmd, ctx
+  parse var cmd verb rest
+  select
+    when verb = "RETURN"  then return rest
+    when verb = "NOTHING" then return
+    when verb = "ENV"     then return ctx~environment
+    when verb = "SET"     then do
+      parse var rest name value
+      ctx[name] = value
+    end
+    when verb = "SYNONYMS" then do
+      ctx~setVar("syn.k", 7)
+      return (ctx~getVar("syn.k") == ctx["syn.k"]) ctx~getVar("nope2")
+    end
+    when verb = "HAS"     then return ctx~hasVar(rest)
+    when verb = "GET"     then return ctx[rest]~string
+    when verb = "DROP"    then ctx~dropVar(rest)
+    when verb = "VARS"    then do
+      handlerLocal = 1
+      v = ctx~variables
+      return v~hasIndex("MINE") v~hasIndex("HANDLERLOCAL")
+    end
+    when verb = "BADNAME" then return self~badName(ctx)
+    when verb = "UPPER"   then do
+      in = ctx~input; out = ctx~output
+      do while in~lines > 0
+        out~lineout(in~linein~upper)
+      end
+    end
+    when verb = "LINES"   then do
+      lines = ctx~input~arrayIn
+      ctx~output~arrayOut(.array~of(lines~items, lines~makeString("L", " ")))
+    end
+    when verb = "CHARS"   then do
+      in = ctx~input; out = ctx~output
+      out~charout(in~charin)               -- "u"
+      out~charout("|")
+      out~lineout(in~linein)               -- the rest of line 1: "no"
+      n = in~chars                         -- "dos" and a line end
+      out~lineout(n - .endOfLine~length + 1 in~linein)
+    end
+    when verb = "CHAROUT" then do
+      out = ctx~output
+      out~charout("ab" || .endOfLine || "c")
+      out~charout("d")                     -- no line end: flushed at the end
+    end
+    when verb = "EOF"     then return self~eof(ctx)
+    when verb = "STREAMS" then
+      ctx~output~lineout(ctx~input~isA(.InputStream) ctx~output~isA(.OutputStream))
+    when verb = "NOWITH"  then return self~noWith(ctx, rest)
+    when verb = "ERR"     then ctx~error~lineout(rest)
+    when verb = "REDIR"   then
+      return ctx~isRedirected("Input") ctx~isRedirected("Output"),
+             ctx~isRedirected("Error") ctx~isRedirected("Same")
+    when verb = "RAISE"   then do
+      parse var rest kind code
+      if kind = "ERROR" then return ctx~raiseError(code)
+      if kind = "FAILURE" then return ctx~raiseFailure(code)
+      if kind = "NOTREADY" then return ctx~raise("notready", code, "no line")
+      parse var code name code
+      return ctx~raise("user" name, code, , "extra")
+    end
+    when verb = "TWICE"   then do
+      x = ctx~raise("FAILURE", 5)
+      ctx["twice"] = self~oneRaise(ctx, .array~of("ERROR", 6))
+      return x
+    end
+    when verb = "BADRAISE"    then return self~badRaise(ctx)
+    when verb = "SYNTAXRAISE" then return ctx~raise("SYNTAX", 98.900, .array~of("the command is wrong"))
+    when verb = "SYNTAXINSIDE" then raise syntax 88.900 array("the handler failed")
+    when verb = "DIVIDE"  then return 1 / 0
+    when verb = "SETDIVIDE"  then do; ctx["x"] = 1; return 1 / 0; end
+    when verb = "GETDIVIDE"  then do; x = ctx["x"]; return 1 / 0; end
+    when verb = "VARSDIVIDE" then do; x = ctx~variables; return 1 / 0; end
+    when verb = "INDIVIDE"   then do; x = ctx~input~linein; return 1 / 0; end
+    when verb = "OUTDIVIDE"  then do; ctx~output~lineout("o"); return 1 / 0; end
+    when verb = "KEEP"    then do; .local~kept = ctx; .local~keptIn = ctx~input; end
+    when verb = "REPLY"   then do
+      reply 0
+      .local~replied = self~afterReply(ctx)
+      return
+    end
+    when verb = "NESTED"  then do
+      address u "INNER"
+      return rc "T:after"
+    end
+    when verb = "HALT"    then do
+      if rest = "ROUTINE" then call halts
+      if rest = "RAISE" then return ctx~raise("HALT", 5)
+      raise halt
+    end
+    otherwise return ctx~raiseFailure(-1)
+  end
+  return 0
+halts:
+  raise halt
+
+::method afterReply
+  use arg ctx
+  signal on syntax name refused
+  x = ctx["x"]
+  return "no error"
+refused:
+  return condition("O")~code
+
+::method badName
+  use arg ctx
+  signal on syntax name bad
+  ctx["1abc"] = 1
+  return "no error"
+bad:
+  return condition("O")~code
+
+::method eof
+  use arg ctx
+  in = ctx~input
+  do while in~lines > 0; x = in~linein; end
+  x = "unset"; seen = "no NOTREADY"
+  call on notready name eof               -- CALL ON: linein still returns
+  x = in~linein
+  ctx~output~lineout(seen "'" || x || "'")
+  return 0
+eof:
+  seen = condition("C")
+  return
+
+::method noWith
+  use arg ctx, which
+  signal on syntax name refused
+  x = ctx~send(which)
+  return "no error"
+refused:
+  return condition("O")~code
+
+-- three wrong raises, each caught: an unknown condition, a SYNTAX code that
+-- is not major.minor, and USER without a name
+::method badRaise
+  use arg ctx
+  codes = ""
+  do try over .array~of(.array~of("FOO", 1), .array~of("SYNTAX", 98), .array~of("USER", 1))
+    codes = codes self~oneRaise(ctx, try)
+  end
+  return codes~strip
+
+::method oneRaise
+  use arg ctx, try
+  signal on syntax name bad
+  x = ctx~raise(try[1], try[2])
+  return "no error"
+bad:
+  return condition("O")~code
+
+
+::class CHU subclass CommandHandler
+::method command
+  return "U:inner"
+
+
+::class CHBase                                   -- CHT2 has another superclass:
+::class CHT2 subclass CHBase inherit CommandHandler   -- the mixin is inherited
+::method command
+  return "T2"
+
+
+::class CHDuck                                   -- has COMMAND, but no .CommandHandler
+::method command
+  return "quack"
+
+
+-- recursion: R sends commands to itself and to T
+::class CHRec subclass CommandHandler
+::method command
+  use arg command, caller
+  parse var command verb n
+  select case verb
+    when "SELF" then do
+      caller["depth"] = caller["depth"] + 1
+      if n > 1 then do
+        depth = 0                                -- the inner command's caller is this method
+        address r "SELF" (n - 1)
+        caller["depth"] = caller["depth"] + depth
+      end
+      return 0
+    end
+    when "REDIR" then do
+      address t "RETURN x" with output stem mine.  -- an inner command with its own WITH
+      in.1 = "inner"; in.0 = 1
+      address t "UPPER" with input stem in. output stem mine.
+      caller~output~lineout("outer got" mine.1~lower)
+      return 0
+    end
+    when "AFTER" then do
+      address t "RETURN x"
+      caller["after"] = caller~isValid
+      return 0
+    end
+    when "CHAIN" then return self~chain(caller)
+    when "LOOP" then do
+      address r "LOOP"
+      return rc
+    end
+    when "DEREG" then do
+      .CommandHandler~deregister("r")
+      return 42
+    end
+    otherwise return -1
+  end
+
+::method chain
+  use arg caller
+  signal on error name e
+  address t "RAISE ERROR 3"
+  return caller~raise("FAILURE", 7, "no error came")
+e:
+  return caller~raise("FAILURE", 9, "inner ERROR rc" rc)
+
+
+::class CHThreaded
+::method run
+  address t "RETURN thread ok"
+  return rc
+
+::method nested
+  use arg times
+  total = 0
+  do times
+    depth = 0
+    address r "SELF 10"
+    total += depth
+  end
+  return total
+
+
+-- forwards every command to the handler it covered when it was registered
+::class CHForward inherit CommandHandler
+::method init
+  expose below
+  use arg name
+  below = .CommandHandler~handler(name)
+::method command
+  expose below
+  use arg command, caller
+  result = below~command(command, caller)
+  if command~word(1) == "RETURN" then return "forwarded" result
+  return result
