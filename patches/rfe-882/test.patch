+::method test_deregister_native
+  -- a native environment other than the default one
+  name = .nil
+  envs = .CommandHandler~environments
+  do index over envs~allIndexes
+    if index \== "", index \== address()~upper, envs[index]~isA(.NativeCommandHandler) then do; name = index; leave; end
+  end
+  if name == .nil then return
+  native = envs[name]
+  self~assertSame(native, .CommandHandler~deregister(name))
+  self~assertFalse(.CommandHandler~environments~hasIndex(name))
+  .CommandHandler~register(name, native)        -- put it back
+  self~assertSame(native, .CommandHandler~handler(name))
+  .CommandHandler~deregister(name)
+  .CommandHandler~register(name, native)        -- as it was: no Rexx handler covering nothing
+  self~assertSame(1, .CommandHandler~handlers(name)~items)
+
+::method test_register_after_deregister
