+/**
+ * Nothing, or the SYNTAX error of liveState (for methods written in Rexx).
+ */
+RexxMethod1(int, cmdcontext_check, CSELF, self)
+{
+    ApiContext ctx(context);
+    try
+    {
+        liveState(context, self, ctx.activity);
+    }
+    catch (NativeActivation *)
