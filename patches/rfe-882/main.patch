+    ApiContext ctx(context);
+    try
+    {
+        RexxObject *covered = ctx.activity->getInstance()->addCommandHandler((RexxString *)name, (RexxObject *)handler);
+        return covered == OREF_NULL ? context->Nil() : ctx.ret(covered);
+    }
+    catch (NativeActivation *)
+    {
+    }
+    return NULLOBJECT;
+}
