--- a/ooRexx/base/keyword/TRACE.testGroup	(revision 13423)
+++ b/ooRexx/base/keyword/TRACE.testGroup	(working copy)
@@ -1356,6 +1356,54 @@
   self~assertTrue(output~lastItem~word(2) > 0, output~lastItem)
 
 
+-- a .traceOutput destination that raises an error (its LINEOUT fails, it has
+-- no LINEOUT, its LINEOUT recurses without end) made the interpreter crash
+-- later when the error was not trapped: it was caught without unwinding the
+-- frames it went through.  Now the trace line goes to the console and the
+-- error is raised where the trace line came from, trapped or not.  Run in a
+-- child process, so that a crash cannot take the test suite with it.
+::method test_failing_traceoutput_destination
+  source = .array~of( -
+    "say test(.Failing~new)", -
+    "say test('')           -- a string has no LINEOUT", -
+    "say test(.Deep~new)", -
+    "-- not trapped: the error is displayed, and the program ends with it", -
+    ".traceOutput~destination(.Failing~new)", -
+    "call traced", -
+    "say 'not reached'", -
+    "exit", -
+    "::routine test", -
+    "  use arg target", -
+    "  .traceOutput~destination(target)", -
+    "  signal on syntax", -
+    "  call traced", -
+    "  .traceOutput~destination", -
+    "  return 'no error'", -
+    "syntax:", -
+    "  .traceOutput~destination", -
+    "  return condition('o')~code", -
+    "::routine traced", -
+    "  trace r", -
+    "  x = 'traced'", -
+    "::class Failing", -
+    "::method lineout", -
+    "  raise syntax 98.900 array('lineout failed')", -
+    "::class Deep", -
+    "::method lineout unguarded", -
+    "  call spin", -
+    "spin: call spin")
+  program = .TemporaryTestFile~new(self, "failing_destination.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  codes = .array~new
+  do line over output
+    if wordpos(line, "98.900 97.1 11.1") > 0 then codes~append(line)
+  end
+  self~assertSame("98.900 97.1 11.1", codes~makeString("line", " "), "rexx ended with rc" theRC)
+  self~assertFalse(output~hasItem("not reached"))
+  self~assertSame("Error 98.900:", output~lastItem~subword(1, 2), "rexx ended with rc" theRC)
+
+
 ::class ArrayStream subclass Array inherit Stream
 ::method init
   expose line
