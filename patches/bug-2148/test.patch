 -- ArrayStream allows to capture TRACE output to an Array
 -- we inherit from Stream just for the SAY method
+-- the TRACEBACK of a condition object is shared with the object CONDITION('O')
+-- answers.  RAISE PROPAGATE of a SYNTAX condition whose TRACEBACK had a line
+-- that is not a string segfaulted when the error was displayed.  It runs in a
+-- child process, so that a crash cannot take the test suite with it.
+::method test_propagate_traceback_not_string
+  source = .array~of( -
+    "call sub", -
+    "exit", -
+    "sub:", -
+    "  signal on syntax", -
+    "  x = 1/0", -
+    "syntax:", -
+    "  condition('o')~traceback~insert(.array~of(1, 2))", -
+    "  raise propagate")
+  program = .TemporaryTestFile~new(self, "propagate_traceback.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  -- the line that is not a string is displayed by its default name
+  self~assertTrue(output~hasItem("an Array"), "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("Error 42.3:", output~lastItem~subword(1, 2))
+
+
 ::class ArrayStream subclass Array inherit Stream
 ::method init
   expose line
