+        if (!condition->strCompare(GlobalNames::SYNTAX))
+        {
+            return;
+        }
+        if (hasFinallyToRun())
+        {
+            activity->clearCurrentCondition();
+            leaveBlocks(OREF_NULL, FINALLY_CONDITION, exceptionObject);
+            throw this;
+        }
+        return;
+    }
