+
+#include "CatchInstruction.hpp"
+
+/**
+ * A FINALLY clause.  It is the last clause of a block, after its
+ * CATCH clauses (if any), and belongs to the same chain of clauses:
+ * it has the owner, the first clause and the END style of a CATCH
+ * clause, and no conditions.  Its code runs whenever control leaves
+ * the block, whatever the reason; what was going to happen then
+ * (nothing, a LEAVE, a RETURN, a condition...) waits in the DoBlock
+ * and goes on when the code reaches the END of the block (see
+ * RexxActivation::leaveBlocks() and endFinally()).
+ */
+class RexxInstructionFinally : public RexxInstructionCatch
+{
+ public:
+    inline RexxInstructionFinally(RESTORETYPE restoreType) : RexxInstructionCatch(restoreType) { ; };
+    RexxInstructionFinally(RexxToken *);
