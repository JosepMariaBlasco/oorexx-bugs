+
+::method test_rule_forward
+  self~assertSyntaxError(99.951, .array~of("do", "nop", "finally", "forward", "end"))
+
+-- nested as deep as you like
+::method test_rule_nested_do
+  self~assertSyntaxError(99.951, .array~of("do", "nop", "finally", "do", "return", "end", "end"))
+
+::method test_rule_nested_if
