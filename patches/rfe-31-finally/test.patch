+-- ---------------------------------------------------------------------------
+-- The rule, at run time (error 98.953): what translation cannot see
+-- ---------------------------------------------------------------------------
+
+::method test_rule_interpret_return
+  self~assertEquals('98.953 RETURN', self~ruleAtRunTime('interpret "return 1"'))
+
+::method test_rule_interpret_exit
+  self~assertEquals('98.953 EXIT', self~ruleAtRunTime('interpret "exit"'))
+
+::method test_rule_interpret_signal
+  self~assertEquals('98.953 SIGNAL', self~ruleAtRunTime('interpret "signal there"'))
+
+::method test_rule_interpret_signal_value
+  self~assertEquals('98.953 SIGNAL', self~ruleAtRunTime('interpret "signal value ''THERE''"'))
+
+::method test_rule_interpret_nested
+  self~assertEquals('98.953 RETURN', self~ruleAtRunTime('interpret "interpret ''return''"'))
+
+-- LEAVE and ITERATE never get out of an INTERPRET
+::method test_rule_interpret_leave
+  self~assertEquals('28.1', self~ruleAtRunTime('interpret "leave"')~word(1))
+
+-- an EXIT in an internal routine called from the clause, at any depth
+::method test_rule_exit_in_internal_routine
+  self~assertEquals('98.953 EXIT', self~ruleAtRunTime('call exits'))
+
+::method test_rule_exit_in_internal_function
+  self~assertEquals('98.953 EXIT', self~ruleAtRunTime('x = exits()'))
+
+::method test_rule_exit_deeper
+  self~assertEquals('98.953 EXIT', self~ruleAtRunTime('call deeper'))
+
+-- running off the end of the code in an internal routine is an EXIT
+::method test_rule_implicit_exit
+  self~assertEquals('98.953 EXIT', self~ruleAtRunTime('call fallsOff'))
+
+-- a RETURN from an internal routine, or an EXIT of a routine or a method
+-- called from the clause, leave nothing
+::method test_rule_calls_allowed
+  self~assertEquals('went on', self~ruleAtRunTime('call returns'))
+  self~assertEquals('went on', self~ruleAtRunTime('call exitRoutine .array~new'))
+  self~assertEquals('went on', self~ruleAtRunTime('interpret "do; nop; finally; nop; end"'))
+
+-- the clause of the interpreted block runs before the error goes on
+::method test_rule_interpret_own_finally
+  log = .array~new
+  self~assertEquals('98.953 RETURN', self~ruleAtRunTime('interpret "do; return; finally; log~append(1); end"', log))
+  self~assertEquals(1, log~items)
+
+-- runs code in a FINALLY clause that a pending RETURN has started, and
+-- says how it ended
+::method ruleAtRunTime private
+  use arg code, log = .nil
+  outcome = 'no'
+  r = sub()
+  -- an error in the clause replaces the pending RETURN
+  if outcome == 'went on' then self~assertEquals('pending', r)
+  else self~assertEquals('caught', r)
+  return outcome
+  sub:
+    do
+      do i = 1 to 1
+        do
+          return 'pending'
+        finally
+          interpret code
+          outcome = 'went on'
+        end
+      end
+    catch syntax
+      outcome = condition('O')~code condition('O')~message~word(1)
+      return 'caught'
+    end
+    return 'no'
+  exits: exit 4
+  deeper:
+    interpret 'call exits'
+    return
+  returns: return
+  there: outcome = 'there'; return 'there'
+  -- the last one, so that it runs off the end of the code
+  fallsOff: nop
+
+-- ---------------------------------------------------------------------------
+-- FINALLY implies a semicolon after it, as THEN, ELSE and OTHERWISE do: an
+-- instruction may follow on the same line
+-- ---------------------------------------------------------------------------
+
+::method test_same_line_assignment
+  out = ''
+  do
+    out = out 'body'
+  finally out = out 'finally'
+  end
+  self~assertEquals(' body finally', out)
+
+-- the rest of the clause goes on in the following lines
+::method test_same_line_and_more
+  out = ''
+  do
+    out = out 'body'
+  finally out = out 'one'
+    out = out 'two'
+  end
+  self~assertEquals(' body one two', out)
+
+::method test_same_line_message
+  out = .mutableBuffer~new
+  do
+    out~append('body')
+  finally out~append(' finally')
+  end
+  self~assertEquals('body finally', out~string)
+
+::method test_same_line_call
+  out = ''
+  do
+    out = out 'body'
+  finally call cleanup 'x'
+  end
+  self~assertEquals(' body cleanup(x)', out)
+  return
+  cleanup: out = out 'cleanup('arg(1)')'; return
+
+-- a function call as a command would be a command; here it is an expression
+-- whose value is assigned
+::method test_same_line_function
+  out = ''
+  do
+    out = out 'body'
+  finally out = cleanup(out)
+  end
+  self~assertEquals(' body cleaned', out)
+  return
+  cleanup: return arg(1) 'cleaned'
+
+::method test_same_line_semicolon
+  out = ''
+  do
+    out = out 'body'
+  finally; out = out 'finally'
+  end
+  self~assertEquals(' body finally', out)
+
+::method test_same_line_several
+  out = ''
+  do
+    out = out 'body'
+  finally out = out 'one'; out = out 'two'; end
+  self~assertEquals(' body one two', out)
+
+-- an empty clause
+::method test_same_line_end
+  out = ''
+  do
+    out = out 'body'
+  finally end
+  self~assertEquals(' body', out)
+
+::method test_whole_block_in_one_line
+  out = ''
+  do; out = out 'body'; finally out = out 'finally'; end
+  self~assertEquals(' body finally', out)
+
+::method test_same_line_do
+  out = ''
+  do
+    out = out 'body'
+  finally do i = 1 to 2
+      out = out i
+    end
+    out = out 'done'
+  end
+  self~assertEquals(' body 1 2 done', out)
+
+::method test_same_line_if
+  out = ''
+  do n = 1 to 2
+    do
+      out = out 'body'
+    finally if n = 1 then out = out 'one'
+      else out = out 'other'
+    end
+  end
+  self~assertEquals(' body one body other', out)
+
+-- a block with clauses of its own
+::method test_same_line_nested_block
+  out = ''
+  do
+    out = out 'body'
+  finally do
+      out = out 'inner'
+      x = 1 / 0
+    catch syntax
+      out = out 'caught' condition('O')~code
+    finally out = out 'inner-finally'
+    end
+  end
+  self~assertEquals(' body inner caught 42.3 inner-finally', out)
+
+::method test_same_line_after_catch
+  out = ''
+  do
+    x = 1 / 0
+  catch syntax
+    out = out 'caught'
+  finally out = out 'finally'
+  end
+  self~assertEquals(' caught finally', out)
+
+::method test_same_line_select
+  out = ''
+  select
+    when out == '' then out = out 'when'
+    otherwise out = out 'otherwise'
+  finally out = out 'finally'
+  end
+  self~assertEquals(' when finally', out)
+
+::method test_same_line_loop
+  out = ''
+  do i = 1 to 3
+    if i = 2 then leave
+    out = out i
+  finally out = out 'f'i
+  end
+  self~assertEquals(' 1 f2', out)
+
+::method test_same_line_return
+  out = ''
+  self~assertEquals('returned', inner())
+  self~assertEquals(' body finally', out)
+  return
+  inner:
+    do
+      out = out 'body'
+      return 'returned'
+    finally out = out 'finally'
+    end
+    return 'no'
+
+-- a condition raised by the instruction on the same line
+::method test_same_line_raises
+  out = ''
+  do
+    do
+      out = out 'body'
+    finally x = 1 / 0
+    end
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' body 42.3', out)
