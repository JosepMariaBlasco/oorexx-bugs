+-- CATCH variable = condition: the FINALLY clause sees the variable, and
+-- FINALLY itself takes none (what follows it is an ordinary assignment)
+::method test_catch_variable_then_finally
+  out = ''
+  do
+    x = 1 / 0
+  catch c = syntax
