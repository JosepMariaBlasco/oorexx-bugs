+::method runAtTracePause
+  use arg typed, expected, shown
+  source = .array~of( -
+    "r = ''", -
+    "do", -
+    "  trace ?r", -
+    "  r = r 'body'", -
+    "catch syntax", -
+    "  r = r 'caught'", -
+    "end", -
+    "trace off", -
+    "say 'r=['r']'", -
+    "exit", -
+    "pauseFails: return 1/0")
+  -- a name of its own for each test: a TemporaryTestFile deletes its file
+  -- when it is collected, which can happen after the next test has created
+  -- one with the same name
+  name = "catch_" || self~getName~lower
+  program = .TemporaryTestFile~new(self, name".tmp.rex")~create(source)
+  input = .TemporaryTestFile~new(self, name".tmp.txt")~create(.array~of(typed, "trace off"))
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName "<" input~quotedName "2>&1", output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC":" output~makeString)
+  -- the trace goes on after the pause, mixed with the output
+  line = ""
+  do l over output
+    if l~startsWith("r=[") then line = l
+  end
+  self~assertSame("r=["expected"]", line, output~makeString)
+  self~assertSame(shown, output~makeString~pos("Error 42.3") > 0, output~makeString)
+
+
+::routine raiseErrorRc
+  use arg rc
+  raise error (rc)
+
+::routine raiseFailureRc
+  use arg rc
+  raise failure (rc)
+
+::routine raiseUserTwo
+  raise user two
+
+::routine raiseUserU5
+  raise user u5
+
+::class catchThree
+::method string
+  return "3"
+
+::class catchAlways
+::method "=="
+  return .true
+
+::class catchHandler subclass CommandHandler
+::method command
+  use arg command, context
+  context~raiseError(.catch.testGroup.obj)
+  return .catch.testGroup.obj
+
+::class CatchHelper
+::method divide
+  x = 1/0
+::method notready
+  call stream 'nonexistent.file.CATCH.testGroup', 'C', 'OPEN READ'
+
+-- collects the lines written to .TraceOutput (TraceObjects, as text)
+::class catchTraceLines subclass array
+::method lineout
+  use arg line
+  if line~isA(.TraceObject) then line = line~traceLine
+  self~append(line)
+  return 0
+
+-- lines for .DebugInput; "trace off" once they run out
+::class catchInputLines
+::method init
+  expose lines
+  use arg lines
+::method linein
+  expose lines
+  if lines~isEmpty then return "trace off"
+  line = lines[1]
+  lines~delete(1)
+  return line
