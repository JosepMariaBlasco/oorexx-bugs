+-- a line typed at an interactive trace pause is not inside the blocks of
+-- the paused code: an error there is shown at the pause, as without
+-- CATCH, and the clause of the paused block does not catch it.  A block
+-- typed at the pause, or in an INTERPRET typed there, catches as anywhere
+-- else: the line typed runs as an INTERPRET does
+-- (the pause comes after the clause that follows TRACE ?R)
+-- the END is traced when a block ends, as it is without CATCH clauses: never
+-- the next CATCH clause, which does not run
+::method test_trace_end_after_clause
+  lines = .catchTraceLines~new
+  .TraceOutput~destination(lines)
+  trace r
+  do
+    x = 1/0
+  catch syntax
+    nop
+  catch error
+    nop
+  end
+  do i = 1 to 2
+    nop
+  catch syntax
+    nop
+  end
+  trace off
+  .TraceOutput~destination
+  ends = 0
+  do line over lines
+    if \line~isA(.string) then iterate
+    self~assertEquals(0, pos("catch error", line), "traced:" line)
+    if line~strip~endsWith("*-* end") then ends += 1
+  end
+  -- the first block's END, and the loop's END after each iteration
+  self~assertEquals(3, ends)
+
+-- interactive tracing pauses at the CATCH clause that caught the condition,
+-- before its instructions run, with RC, SIGL and the variable already set
+::method test_trace_pause_at_catch
+  .TraceOutput~destination(.catchTraceLines~new)
+  .DebugInput~destination(.catchInputLines~new(.array~of("", "paused = rc sigl c~code; trace off")))
+  paused = ""
+  trace ?r
+  do
+    y = 1 / 0
+  catch c = syntax
+    r = "caught"
+  end
+  .TraceOutput~destination
+  .DebugInput~destination
+  self~assertSame("caught", r)
+  self~assertSame(42 (.line - 7) 42.3, paused)
+
