+
+-- a line typed at an interactive trace pause is not inside the blocks of
+-- the paused code (as for CATCH): an error there is shown at the pause and
+-- does not leave the paused block, whose FINALLY clause runs once, when the
+-- block ends.  The clauses of a block typed at the pause, or in an INTERPRET
+-- typed there, work as anywhere else: the FINALLY clause runs, and then
+-- the error is shown, unless a typed CATCH clause caught it
+-- (the pause comes after the clause that follows TRACE ?R)
+::method test_trace_pause_interpret
+  self~runAtTracePause('interpret "y = 1/0"', " body finally", .true)
+
+::method test_trace_pause_call
+  self~runAtTracePause("call pauseFails", " body finally", .true)
+
+::method test_trace_pause_typed_block
+  self~runAtTracePause('do; y = 1/0; finally r = r "typed"; end; r = r "after"', " body typed finally", .true)
+
+::method test_trace_pause_typed_block_ok
+  self~runAtTracePause('do; nop; finally r = r "typed"; end; r = r "after"', " body typed after finally", .false)
+
+::method test_trace_pause_typed_block_catch
+  self~runAtTracePause('do; y = 1/0; catch syntax; r = r "caught"; finally r = r "typed"; end; r = r "after"', " body caught typed after finally", .false)
+
+::method test_trace_pause_typed_block_nested
+  self~runAtTracePause('do; do; y = 1/0; finally r = r "f1"; end; finally r = r "f2"; end', " body f1 f2 finally", .true)
+
+::method test_trace_pause_typed_block_call
+  self~runAtTracePause('do; call pauseFails; finally r = r "typed"; end', " body typed finally", .true)
+
+-- an error in the typed FINALLY clause replaces the pending one
+::method test_trace_pause_typed_block_clause_fails
+  self~runAtTracePause('do; y = 1/0; finally r = r "typed"; z = 2/0; r = r "no"; end', " body typed finally", .true)
+
+-- two blocks in the line: the error of the second one ends the line
+::method test_trace_pause_typed_two_blocks
+  self~runAtTracePause('do; y = 1/0; catch syntax; r = r "c"; end; do; z = 1/0; finally r = r "f"; end; r = r "no"', " body c f finally", .true)
+
+::method test_trace_pause_interpreted_block
+  self~runAtTracePause('interpret "do; y = 1/0; finally r = r ''inner''; end"', " body inner finally", .true)
+
+::method test_trace_pause_interpreted_block_ok
+  self~runAtTracePause('interpret "do; nop; finally r = r ''inner''; end"', " body inner finally", .false)
+
+-- tracing: the FINALLY clause is traced once, when its code starts, and the
+-- END when that code reaches it; a loop traces its END after each iteration,
+-- as without clauses, and a CATCH clause that does not run is never traced
+::method test_trace_clause_and_end
+  lines = .finallyTraceLines~new
+  .TraceOutput~destination(lines)
+  trace r
+  do
+    x = 1
+  finally
+    y = 2
+  end
+  do i = 1 to 2
+    nop
+  finally
+    z = 3
+  end
+  do
+    x = 1/0
+  catch syntax
+    nop
+  catch error
+    nop
+  finally
+    nop
+  end
+  trace off
+  .TraceOutput~destination
+  ends = 0
+  finallys = 0
+  do line over lines
+    if \line~isA(.string) then iterate
+    self~assertEquals(0, pos("catch error", line), "traced:" line)
+    if line~strip~endsWith("*-* end") then ends += 1
+    if line~strip~endsWith("*-* finally") then finallys += 1
+  end
+  -- one FINALLY per block; END: the first block, the loop after each of its
+  -- two iterations and after its clause, the third block
+  self~assertEquals(3, finallys)
+  self~assertEquals(5, ends)
+
+::method runAtTracePause
+  use arg typed, expected, shown
+  source = .array~of( -
+    "r = ''", -
+    "do", -
+    "  trace ?r", -
+    "  r = r 'body'", -
+    "finally", -
+    "  r = r 'finally'", -
+    "end", -
+    "trace off", -
+    "say 'r=['r']'", -
+    "exit", -
+    "pauseFails: return 1/0")
+  -- a name of its own for each test: a TemporaryTestFile deletes its file
+  -- when it is collected, which can happen after the next test has created
+  -- one with the same name
+  name = "finally_" || self~getName~lower
+  program = .TemporaryTestFile~new(self, name".tmp.rex")~create(source)
+  input = .TemporaryTestFile~new(self, name".tmp.txt")~create(.array~of(typed, "trace off"))
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName "<" input~quotedName "2>&1", output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC":" output~makeString)
+  -- the trace goes on after the pause, mixed with the output
+  line = ""
+  do l over output
+    if l~startsWith("r=[") then line = l
+  end
+  self~assertSame("r=["expected"]", line, output~makeString)
+  self~assertSame(shown, output~makeString~pos("Error 42.3") > 0, output~makeString)
+
+
+-- a condition nobody handles: the clauses run before the error is reported
+::method test_child_unhandled
+  source = .array~of( -
+    "call sub", -
+    "exit", -
+    "sub:", -
+    "  do", -
+    "    do", -
+    "      x = 1/0", -
+    "    finally", -
+    "      say 'inner'", -
+    "    end", -
+    "  finally", -
+    "    say 'outer'", -
+    "  end")
+  program = .TemporaryTestFile~new(self, "finally_unhandled.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName "2>&1", output)
+  self~assertFalse(theRC = 0, "rexx expected to end with an error")
+  self~assertSame("inner", output[1])
+  self~assertSame("outer", output[2])
+  self~assertTrue(output~makeString('L', ' ')~pos("Error 42.3") > 0)
+
+-- the program's EXIT, from an internal routine, with its return code
+::method test_child_exit
+  source = .array~of( -
+    "do", -
+    "  call sub", -
+    "finally", -
+    "  say 'main'", -
+    "end", -
+    "say 'not here'", -
+    "exit 1", -
+    "sub:", -
+    "  do", -
+    "    exit 3", -
+    "  finally", -
+    "    say 'sub'", -
+    "  end")
+  program = .TemporaryTestFile~new(self, "finally_exit.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(3, theRC)
+  self~assertSame("sub main", output~makeString('L', ' '))
+
+-- every way out, many times, with a garbage collection while the result,
+-- the block name or the condition object is waiting in the block
+::method test_child_gc
+  source = .array~of( -
+    "n = 0; m = 0; k = 0; fin = 0", -
+    "do i = 1 to 50", -
+    "  if f(i) == 'result' i then n += 1", -
+    "  do", -
+    "    call g i", -
+    "  catch syntax", -
+    "    call gc", -
+    "    if condition('O')~code = 42.3 then m += 1", -
+    "  finally", -
+    "    call gc", -
+    "  end", -
+    "  do label outer", -
+    "    do j = 1 to 3", -
+    "      leave outer", -
+    "    finally", -
+    "      call gc", -
+    "      k += 1", -
+    "    end", -
+    "  end", -
+    "end", -
+    "say 'n='n 'm='m 'k='k 'fin='fin", -
+    "exit", -
+    "f: procedure expose fin", -
+    "  do", -
+    "    do j = 1 to 2", -
+    "      return 'result' arg(1)", -
+    "    finally", -
+    "      call gc", -
+    "      x = .array~new(100)", -
+    "    end", -
+    "  finally", -
+    "    fin = arg(1)", -
+    "    call gc", -
+    "  end", -
+    "g: procedure", -
+    "  do", -
+    "    interpret 'x = arg(1) / 0'", -
+    "  finally", -
+    "    call gc", -
+    "  end", -
+    "  return")
+  program = .TemporaryTestFile~new(self, "finally_gc.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("n=50 m=50 k=50 fin=50", output~lastItem)
+
+
+::routine raiseErrorRc
+  use arg rc
+  raise error (rc)
+
+::routine raiseTrouble
+  raise user trouble
+
+::routine exitRoutine
+  use arg log
+  do
+    exit 5
+  finally
+    log~append('finally')
+  end
+
+::routine propagatingRoutine
+  use arg log
+  do
+    do
+      x = 1/0
+    catch syntax
+      log~append('catch')
+      raise propagate
+    finally
+      log~append('a')
+    end
+  finally
+    log~append('b')
+  end
+
+::routine exitFromCatch
+  use arg log
+  do
+    x = 1/0
+  catch syntax
+    log~append('catch')
+    exit 'exit result'
+  finally
+    log~append('finally')
+  end
+
+::routine failingRoutine
+  use arg log
+  do
+    do
+      x = 1/0
+    finally
+      log~append('inner')
+    end
+  finally
+    log~append('outer')
+  end
+
+::class FinallyHelper
+::method returns
+  use arg log
+  do
+    log~append('body')
+    return 'method result'
+  finally
+    log~append('finally')
+  end
+
+::method exits
+  use arg log
+  do
+    call level1
+    log~append('no')
+  finally
+    log~append('top')
+  end
+  return 'no'
+  level1:
+    do
+      interpret 'call level2'
+    finally
+      log~append('level1')
+    end
+    return
+  level2:
+    do i = 1 to 3
+      x = level3()
+    finally
+      log~append('level2')
+    end
+    return
+  level3:
+    do
+      exit 'exit result'
+    finally
+      log~append('level3')
+    end
+
+::method fails
+  use arg log
+  do
+    self~noSuchMethod
+  finally
+    log~append('method')
+  end
+
+-- RAISE with no RETURN, in an internal routine, ends the method
+::method raises
+  use arg log
+  do
+    call level2
+    log~append('no')
+  finally
+    log~append('level1')
+  end
+  return
+  level2:
+    do
+      raise user oops description 'described'
+    finally
+      log~append('level2')
+    end
+
+::method forwards
+  use arg log
+  do
+    forward message 'target'
+  finally
+    log~append('finally')
+  end
+
+::method target
+  use arg log
+  log~append('target')
+  return 'target result'
+
+::method replies
+  use arg log
+  do
+    log~append('body')
+    reply 'replied'
+    log~append('after')
+  finally
+    log~append('finally')
+  end
+
+::method repliesFromCatch
+  use arg log
+  do
+    x = 1/0
+  catch syntax
+    log~append('catch')
+    reply 'replied'
+    log~append('after')
+  finally
+    log~append('finally')
+  end
+
+::method wait
+  return
+
+::class FinallyComparator
+::method init
+  expose log
+  use arg log
+::method compare
+  expose log
+  do
+    return arg(1) / 0
+  finally
+    log~append('comparator')
+  end
+
+
+-- collects the trace output (as CATCH.testGroup's catchTraceLines)
+::class finallyTraceLines subclass array
+::method lineout
+  use arg line
+  if line~isA(.TraceObject) then line = line~traceLine
+  self~append(line)
+  return 0
