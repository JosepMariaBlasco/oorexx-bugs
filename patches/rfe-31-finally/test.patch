+    address "" "rexxc" self~q(source~fullName) self~q(compiled~fullName) "-s" with output stem o. error stem e.
+    self~assertRc(0, rc, "rexxc expected to compile" case[2] "with rc 0")
+    self~assertSame(case[1], requiredLanguageLevel(compiled), "required language level of:" case[2])
+  end
