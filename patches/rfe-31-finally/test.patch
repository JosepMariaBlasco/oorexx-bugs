+-- runs code in a FINALLY clause that a pending RETURN has started, and
+-- says how it ended
+::method ruleAtRunTime private
+  use arg code, log = .nil
+  outcome = 'no'
+  r = sub()
+  -- an error in the clause replaces the pending RETURN
+  if outcome == 'went on' then self~assertEquals('pending', r)
+  else self~assertEquals('caught', r)
+  return outcome
+  sub:
+    do
+      do i = 1 to 1
+        do
+          return 'pending'
+        finally
+          interpret code
+          outcome = 'went on'
+        end
+      end
+    catch syntax
+      outcome = condition('O')~code condition('O')~message~word(1)
+      return 'caught'
+    end
+    return 'no'
+  exits: exit 4
+  deeper:
+    interpret 'call exits'
+    return
+  returns: return
+  there: outcome = 'there'; return 'there'
+  -- the last one, so that it runs off the end of the code
+  fallsOff: nop
