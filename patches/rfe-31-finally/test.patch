+  self~assertSyntaxError(99.951, .array~of("do", "nop", "finally", "do", "nop", "finally", "return", "end", "end"))
+
+::method test_rule_nested_loop_leaves_outer
+  self~assertSyntaxError(99.951, .array~of("do i = 1 to 2", "nop", "finally", "do j = 1 to 2", "leave i", "end", "end"))
+
+-- what stays inside the clause, or does not leave anything, is allowed
+::method test_rule_allowed
+  out = ''
+  do
+    nop
+  finally
+    do i = 1 to 3
+      if i = 1 then iterate
+      if i = 2 then iterate i
+      leave
+    end
+    out = out i
+    do label inner
+      leave inner
+    end
+    signal on user never
+    signal off user never
+    call sub
+    r = sub2()
+    out = out r
+    interpret "do j = 1 to 2; leave; end"
+    out = out j
+  end
+  self~assertEquals(' 3 sub2 1', out)
+  return
+  sub: return
+  sub2: return 'sub2'
+
+-- the error message names the instruction and the line of the clause
+::method test_rule_message
+  signal on syntax
+  r = .routine~new('rule', .array~of("do", "nop", "finally", "do", "exit", "end", "end"))
+  self~fail('error 99.951 expected')
+  return
+  syntax:
+  self~assertEquals(99.951, condition('O')~code)
+  self~assertEquals('EXIT must not leave the FINALLY clause on line 3.', condition('O')~message)
