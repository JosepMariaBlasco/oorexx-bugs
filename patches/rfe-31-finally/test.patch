+::requires 'ooTest.frm' -- load the ooRexxUnit classes
+::requires 'FileUtils.cls' -- for issueCmd
+
+-- FINALLY clause of DO, LOOP and SELECT (prototype for RFE #31, on top of
+-- the CATCH prototype).  The rule: a FINALLY clause runs whenever control
+-- leaves its block, and it can only end by reaching its end, or by raising
+-- a condition.
+::class "FINALLY.testGroup" subclass ooTestCase public
+
+-- ---------------------------------------------------------------------------
+-- The block ends by itself
+-- ---------------------------------------------------------------------------
+
+::method test_body_ends
+  out = ''
+  do
+    out = out 'body'
+  finally
+    out = out 'finally'
+  end
+  out = out 'after'
+  self~assertEquals(' body finally after', out)
+
+-- the clause runs once, when the loop ends, not after each iteration
+::method test_loop_ends
+  out = ''
+  do i = 1 to 3
+    out = out i
+  finally
+    out = out 'f'i
+  end
+  self~assertEquals(' 1 2 3 f4', out)
+
+-- the loop was entered, even if its body never ran
+::method test_loop_no_iterations
+  out = ''
+  do i = 1 to 0
+    out = out i
+  finally
+    out = out 'f'i
+  end
+  self~assertEquals(' f1', out)
+
+::method test_loop_forms
+  out = ''
+  k = 0
+  do forever
+    k += 1
+    if k = 3 then leave
+  finally
+    out = out 'forever'k
+  end
+  do while k < 5
+    k += 1
+  finally
+    out = out 'while'k
+  end
+  do until k > 6
+    k += 1
+  finally
+    out = out 'until'k
+  end
+  do 2
+    k += 1
+  finally
+    out = out 'count'k
+  end
+  do x over .array~of('a', 'b')
+    nop
+  finally
+    out = out 'over' || x
+  end
+  loop label named i = 1 to 2
+    nop
+  finally
+    out = out 'loop'i
+  end named
+  self~assertEquals(' forever3 while5 until7 count9 overb loop3', out)
+
+::method test_select_when
+  out = ''
+  select
+    when 0 then out = out 'no'
+    when 1 then out = out 'when'
+    otherwise out = out 'no'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' when finally', out)
+
+::method test_select_otherwise
+  out = ''
+  select
+    when 0 then out = out 'no'
+    otherwise
+      out = out 'otherwise'
+      out = out 'more'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' otherwise more finally', out)
+
+::method test_select_case
+  out = ''
+  select case 2
+    when 1 then out = out 'no'
+    when 2 then out = out 'two'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' two finally', out)
+
+-- no WHEN is true and there is no OTHERWISE: the clause runs, then error 7.3
+::method test_select_nothing_selected
+  out = ''
+  do
+    select
+      when 0 then out = out 'no'
+    finally
+      out = out 'finally'
+    end
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' finally 7.3', out)
+
+-- CATCH clauses first, FINALLY last; with no condition only FINALLY runs
+::method test_catch_and_finally_no_condition
+  out = ''
+  do
+    out = out 'body'
+  catch syntax
+    out = out 'catch'
+  catch any
+    out = out 'any'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' body finally', out)
+
+-- FINALLY is only a keyword at the start of a clause that is not an assignment
+::method test_finally_variable
+  finally = 3
+  do
+    finally = finally + 1
+  finally
+    finally += 1
+  end
+  self~assertEquals(5, finally)
+
+-- ---------------------------------------------------------------------------
+-- LEAVE and ITERATE
+-- ---------------------------------------------------------------------------
+
+::method test_leave_own_loop
+  out = ''
+  do i = 1 to 5
+    if i = 2 then leave
+    out = out i
+  finally
+    out = out 'f'i
+  end
+  self~assertEquals(' 1 f2', out)
+
+::method test_leave_labeled_do
+  out = ''
+  do label a
+    out = out 'body'
+    leave a
+    out = out 'no'
+  finally
+    out = out 'finally'
+  end a
+  self~assertEquals(' body finally', out)
+
+-- an ITERATE of the loop itself does not leave it
+::method test_iterate_own_loop
+  out = ''
+  do i = 1 to 3
+    if i = 2 then iterate
+    out = out i
+  finally
+    out = out 'f'
+  end
+  self~assertEquals(' 1 3 f', out)
+
+-- ...but it leaves the blocks inside the loop
+::method test_iterate_own_loop_from_nested_block
+  out = ''
+  do i = 1 to 3
+    do
+      if i = 2 then iterate
+      out = out i
+    finally
+      out = out 'f'i
+    end
+  finally
+    out = out 'F'
+  end
+  self~assertEquals(' 1 f1 f2 3 f3 F', out)
+
+-- the clauses of all the blocks that are left run, innermost first
+::method test_leave_outer
+  out = ''
+  do i = 1 to 3
+    do j = 1 to 3
+      do
+        if j = 2 then leave i
+        out = out i'.'j
+      finally
+        out = out 'a'
+      end
+    finally
+      out = out 'b'
+    end
+  finally
+    out = out 'c'
+  end
+  self~assertEquals(' 1.1 a a b c', out)
+
+::method test_iterate_outer
+  out = ''
+  do i = 1 to 2
+    do j = 1 to 3
+      do
+        if j = 2 then iterate i
+        out = out i'.'j
+      finally
+        out = out 'a'
+      end
+    finally
+      out = out 'b'
+    end
+  finally
+    out = out 'c'
+  end
+  self~assertEquals(' 1.1 a a b 2.1 a a b c', out)
+
+-- a LEAVE that has nothing to leave is an error raised in the body
+::method test_leave_unknown_name
+  out = ''
+  do
+    do i = 1 to 2
+      interpret 'leave nowhere'
+    finally
+      out = out 'finally'
+    end
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' finally 28.3', out)
+
+-- ---------------------------------------------------------------------------
+-- RETURN and EXIT
+-- ---------------------------------------------------------------------------
+
+-- the result is evaluated before the clause runs
+::method test_return
+  out = ''
+  v = 'before'
+  r = sub()
+  self~assertEquals('before', r)
+  self~assertEquals(' body finally', out)
+  return
+  sub:
+    do
+      out = out 'body'
+      return v
+    finally
+      out = out 'finally'
+      v = 'after'
+    end
+
+::method test_return_nested
+  out = ''
+  self~assertEquals('value', sub())
+  self~assertEquals(' a b c', out)
+  return
+  sub:
+    do i = 1 to 3
+      do
+        select
+          when 1 then return 'value'
+        finally
+          out = out 'a'
+        end
+      finally
+        out = out 'b'
+      end
+    finally
+      out = out 'c'
+    end
+    return 'no'
+
+::method test_return_no_value
+  out = ''
+  call sub
+  self~assertEquals(' body finally', out)
+  return
+  sub:
+    do
+      out = out 'body'
+      return
+    finally
+      out = out 'finally'
+    end
+
+::method test_return_from_method
+  log = .array~new
+  self~assertEquals('method result', .FinallyHelper~new~returns(log))
+  self~assertEquals('body finally', log~makeString('L', ' '))
+
+-- an EXIT in an internal routine ends the method: all the levels run
+-- their clauses, innermost first
+::method test_exit_internal_routines
+  log = .array~new
+  self~assertEquals('exit result', .FinallyHelper~new~exits(log))
+  self~assertEquals('level3 level2 level1 top', log~makeString('L', ' '))
+
+::method test_exit_routine
+  log = .array~new
+  self~assertEquals(5, exitRoutine(log))
+  self~assertEquals('finally', log~makeString('L', ' '))
+
+-- an internal routine that runs off the end of the code is an EXIT too
+::method test_implicit_exit
+  log = .array~new
+  r = .routine~new('implicit', .array~of( -
+    "use arg log", -
+    "do", -
+    "  call sub", -
+    "finally", -
+    "  log~append('finally')", -
+    "end", -
+    "log~append('not here')", -
+    "return", -
+    "sub: log~append('sub')"))
+  r~call(log)
+  self~assertEquals('sub finally', log~makeString('L', ' '))
+
+-- ---------------------------------------------------------------------------
+-- SIGNAL
+-- ---------------------------------------------------------------------------
+
+::method test_signal
+  out = ''
+  do i = 1 to 3
+    do
+      line = .line; signal there
+    finally
+      out = out 'a'
+    end
+  finally
+    out = out 'b'
+  end
+  out = out 'no'
+  there:
+  self~assertEquals(' a b', out)
+  self~assertEquals(line, sigl)
+
+::method test_signal_value
+  out = ''
+  do
+    signal value 'TH' || 'ERE'
+  finally
+    out = out 'finally'
+  end
+  out = out 'no'
+  there:
+  self~assertEquals(' finally', out)
+
+-- a SIGNAL ON trap: the clauses run, then the jump is taken, and the
+-- condition information is that of the trapped condition
+::method test_signal_on
+  out = ''
+  signal on syntax name trapped
+  do
+    do
+      line = .line; x = 1/0
+    finally
+      out = out 'a'
+      -- another condition, caught here, does not disturb the pending one
+      do
+        y = 1 + 'x'
+      catch syntax
+        out = out condition('O')~code
+      end
+    end
+  finally
+    out = out 'b'
+  end
+  out = out 'no'
+  trapped:
+  self~assertEquals(' a 41.1 b', out)
+  self~assertEquals(42.3, condition('O')~code)
+  self~assertEquals('SIGNAL', condition('I'))
+  self~assertEquals(line, sigl)
+
+-- ---------------------------------------------------------------------------
+-- Conditions
+-- ---------------------------------------------------------------------------
+
+-- caught by the block itself: CATCH, then FINALLY
+::method test_catch_then_finally
+  out = ''
+  do
+    x = 1/0
+  catch syntax
+    out = out 'catch'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' catch finally', out)
+
+-- caught by an outer block: the inner FINALLY runs before the CATCH clause
+::method test_finally_before_outer_catch
+  out = ''
+  do
+    do i = 1 to 3
+      do
+        line = .line; x = 1/0
+      finally
+        out = out 'a'
+      end
+    catch novalue
+      out = out 'no'
+    finally
+      out = out 'b'
+    end
+    out = out 'no'
+  catch syntax
+    out = out 'catch'
+    self~assertEquals(line, sigl)
+    self~assertEquals(42.3, condition('O')~code)
+    self~assertEquals('CATCH', condition('I'))
+  finally
+    out = out 'c'
+  end
+  self~assertEquals(' a b catch c', out)
+
+-- the loop's own clause is covered
+::method test_loop_control_condition
+  out = ''
+  do
+    do i = 1 to 1/0
+      out = out 'no'
+    finally
+      out = out 'finally'
+    end
+  catch syntax
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+
+-- raised in internal routines, caught where they were called from
+::method test_internal_routines
+  out = ''
+  do
+    call level1
+    out = out 'no'
+  catch syntax
+    out = out 'catch'
+  finally
+    out = out 'top'
+  end
+  self~assertEquals(' level3 level1 catch top', out)
+  return
+  level1:
+    do
+      call level2
+    finally
+      out = out 'level1'
+    end
+    return
+  level2:
+    call level3
+    return
+  level3: procedure expose out
+    do
+      x = 1/0
+    finally
+      out = out 'level3'
+    end
+    return
+
+-- a condition other than SYNTAX, raised in an internal routine
+::method test_internal_routine_novalue
+  out = ''
+  do
+    call sub
+  catch novalue
+    out = out 'catch' condition('D')
+  end
+  self~assertEquals(' finally catch NOSUCHVARIABLE', out)
+  return
+  sub:
+    do
+      x = noSuchVariable
+    finally
+      out = out 'finally'
+    end
+    return
+
+-- a SYNTAX condition that goes out of a routine and of a method
+::method test_out_of_routine
+  log = .array~new
+  do
+    call failingRoutine log
+  catch syntax
+    log~append('catch' condition('O')~code)
+  end
+  self~assertEquals('inner outer catch 42.3', log~makeString('L', ' '))
+
+::method test_out_of_method
+  log = .array~new
+  do
+    .FinallyHelper~new~fails(log)
+  catch syntax
+    log~append('catch' condition('O')~code)
+  finally
+    log~append('caller')
+  end
+  self~assertEquals('method catch 97.1 caller', log~makeString('L', ' '))
+
+-- native code between the two activations (sortWith calls the comparator)
+::method test_through_native_code
+  log = .array~new
+  do
+    do
+      .array~of(3, 1, 2)~sortWith(.FinallyComparator~new(log))
+    finally
+      log~append('caller')
+    end
+  catch syntax
+    log~append('catch' condition('O')~code)
+  end
+  self~assertEquals('comparator caller catch 42.3', log~makeString('L', ' '))
+
+-- a condition raised in a CATCH clause: FINALLY still runs
+::method test_condition_in_catch_clause
+  out = ''
+  do
+    do
+      x = 1/0
+    catch syntax
+      out = out 'catch'
+      y = 1 + 'x'
+    finally
+      out = out 'finally'
+    end
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' catch finally 41.1', out)
+
+-- leaving from a CATCH clause
+::method test_leave_from_catch_clause
+  out = ''
+  do i = 1 to 3
+    do
+      x = 1/0
+    catch syntax
+      out = out 'catch'i
+      if i = 1 then iterate i
+      leave i
+    finally
+      out = out 'finally'i
+    end
+    out = out 'no'
+  end
+  self~assertEquals(' catch1 finally1 catch2 finally2', out)
+
+::method test_return_from_catch_clause
+  out = ''
+  self~assertEquals('caught', sub())
+  self~assertEquals(' finally', out)
+  return
+  sub:
+    do
+      x = 1/0
+    catch syntax
+      return 'caught'
+    finally
+      out = out 'finally'
+    end
+
+::method test_signal_from_catch_clause
+  out = ''
+  do
+    x = 1/0
+  catch syntax
+    out = out 'catch'
+    signal there
+  finally
+    out = out 'finally'
+  end
+  out = out 'no'
+  there:
+  self~assertEquals(' catch finally', out)
+
+::method test_exit_from_catch_clause
+  log = .array~new
+  self~assertEquals('exit result', exitFromCatch(log))
+  self~assertEquals('catch finally', log~makeString('L', ' '))
+
+::method test_reply_from_catch_clause
+  log = .array~new
+  helper = .FinallyHelper~new
+  self~assertEquals('replied', helper~repliesFromCatch(log))
+  -- the rest of the method is guarded, so this waits for it
+  helper~wait
+  self~assertEquals('catch after finally', log~makeString('L', ' '))
+
+-- CALL ON: nothing is left, the body goes on and FINALLY runs once
+::method test_call_on
+  out = ''
+  call on user trouble name handler
+  do
+    call raiseTrouble
+    out = out 'body'
+  finally
+    out = out 'finally'
+  end
+  call off user trouble
+  self~assertEquals(' handler body finally', out)
+  return
+  handler:
+    out = out 'handler'
+    return
+
+-- ---------------------------------------------------------------------------
+-- A condition raised in the clause replaces what was pending
+-- ---------------------------------------------------------------------------
+
+::method test_condition_replaces_return
+  out = ''
+  do
+    r = sub()
+    out = out 'no' r
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' finally 42.3', out)
+  return
+  sub:
+    do
+      return 'value'
+    finally
+      out = out 'finally'
+      x = 1/0
+    end
+
+::method test_condition_replaces_condition
+  out = ''
+  do
+    do
+      x = 1/0
+    finally
+      out = out 'finally'
+      y = 1 + 'x'
+    end
+  catch syntax
+    out = out condition('O')~code
+  end
+  self~assertEquals(' finally 41.1', out)
+
+::method test_condition_replaces_leave
+  out = ''
+  do i = 1 to 3
+    do
+      do
+        leave i
+      finally
+        out = out 'finally'i
+        raise syntax 93.900 array ('mine')
+      end
+    catch syntax
+      out = out condition('O')~code
+    end
+  end
+  self~assertEquals(' finally1 93.900 finally2 93.900 finally3 93.900', out)
+
+-- a SIGNAL ON trap that fires in the clause takes over
+::method test_trap_in_clause_replaces_return
+  self~assertEquals('trapped 42.3', sub())
+  return
+  sub:
+    signal on syntax name trapped
+    do
+      return 'value'
+    finally
+      x = 1/0
+    end
+    trapped:
+    return 'trapped' condition('O')~code
+
+-- a CALL ON trap that fires in the clause does not end it
+::method test_call_on_in_clause
+  out = ''
+  self~assertEquals('value', sub())
+  self~assertEquals(' handler finally', out)
+  return
+  sub:
+    call on user trouble name handler
+    do
+      return 'value'
+    finally
+      call raiseTrouble
+      out = out 'finally'
+    end
+  handler:
+    out = out 'handler'
+    return
+
+-- clauses inside clauses
+::method test_nested_in_clauses
+  out = ''
+  do
+    do
+      x = 1/0
+    catch syntax
+      do
+        out = out 'a'
+      finally
+        out = out 'b'
+      end
+    finally
+      do i = 1 to 2
+        if i = 2 then leave
+      finally
+        out = out 'c'
+      end
+      out = out 'd'
+    end
+  finally
+    out = out 'e'
+  end
+  self~assertEquals(' a b c d e', out)
+
+-- ---------------------------------------------------------------------------
+-- RAISE, FORWARD, REPLY
+-- ---------------------------------------------------------------------------
+
+::method test_raise_return
+  out = ''
+  do
+    call sub
+    out = out 'no'
+  catch user oops
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+  return
+  sub:
+    do
+      raise user oops return
+    finally
+      out = out 'finally'
+    end
+
+::method test_raise_from_method
+  log = .array~new
+  do
+    .FinallyHelper~new~raises(log)
+    log~append('no')
+  catch user oops
+    log~append('catch' condition('D'))
+  end
+  self~assertEquals('level2 level1 catch described', log~makeString('L', ' '))
+
+-- RAISE PROPAGATE ends the routine and raises the condition in its caller
+::method test_raise_propagate
+  log = .array~new
+  do
+    call propagatingRoutine log
+    log~append('no')
+  catch syntax
+    log~append(condition('O')~code)
+  end
+  self~assertEquals('catch a b 42.3', log~makeString('L', ' '))
+
+-- RAISE is allowed in the clause: it ends by raising a condition
+::method test_raise_in_clause
+  out = ''
+  do
+    call sub
+    out = out 'no'
+  catch user oops
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+  return
+  sub:
+    do
+      return 'value'
+    finally
+      out = out 'finally'
+      raise user oops return
+    end
+
+-- the message is sent, then the clause runs, then its result is returned
+::method test_forward
+  log = .array~new
+  self~assertEquals('target result', .FinallyHelper~new~forwards(log))
+  self~assertEquals('target finally', log~makeString('L', ' '))
+
+-- REPLY does not leave the block: the clause runs once, when the method
+-- leaves the block on its new thread
+::method test_reply
+  log = .array~new
+  helper = .FinallyHelper~new
+  self~assertEquals('replied', helper~replies(log))
+  -- the rest of the method is guarded, so this waits for it
+  helper~wait
+  self~assertEquals('body after finally', log~makeString('L', ' '))
+
+-- ---------------------------------------------------------------------------
+-- INTERPRET
+-- ---------------------------------------------------------------------------
+
+::method test_interpret_block
+  out = ''
+  interpret "do i = 1 to 2; if i = 2 then leave; finally; out = out 'finally'i; end"
+  self~assertEquals(' finally2', out)
+
+::method test_interpret_condition
+  out = ''
+  do
+    interpret "do; x = 1/0; finally; out = out 'interpreted'; end"
+  catch syntax
+    out = out 'catch'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' interpreted catch finally', out)
+
+-- the interpreted code and the code that interprets it both have clauses
+::method test_interpret_return
+  out = ''
+  self~assertEquals('value', sub())
+  self~assertEquals(' interpreted finally', out)
+  return
+  sub:
+    do
+      interpret "do; return 'value'; finally; out = out 'interpreted'; end"
+    finally
+      out = out 'finally'
+    end
+
+::method test_interpret_signal
+  out = ''
+  do
+    interpret "do; signal there; finally; out = out 'interpreted'; end"
+  finally
+    out = out 'finally'
+  end
+  out = out 'no'
+  there:
+  self~assertEquals(' interpreted finally', out)
+
+-- a SIGNAL ON trap of the code that interprets
+::method test_interpret_signal_on
+  out = ''
+  signal on syntax name trapped
+  do
+    interpret "do; x = 1/0; finally; out = out 'interpreted'; end"
+  finally
+    out = out 'finally'
+  end
+  out = out 'no'
+  trapped:
+  self~assertEquals(' interpreted finally', out)
+  self~assertEquals(42.3, condition('O')~code)
+
+-- on the way to a SIGNAL ON trap the FINALLY clauses see nothing of the
+-- trapped condition, as on the way to a CATCH clause: CONDITION() and RC are
+-- set when the jump is taken, and RC is the trapped one even if a clause
+-- caught a condition of its own
+::method test_signal_on_condition_info_after_clauses
+  seen = ''
+  rc = 'none'
+  signal on syntax name trapped
+  do
+    do
+      x = 1/0
+    finally
+      seen = seen '['condition('C') rc']'
+    end
+  finally
+    do; y = 'a' + 1; catch syntax; seen = seen 'caught' rc; end
+  end
+  seen = seen 'no'
+  trapped:
+  self~assertEquals(' [ none] caught 41', seen)
+  self~assertEquals(42, rc)
+  self~assertEquals(42.3, condition('O')~code)
+
+-- the same for an error in an INTERPRET (the trap is taken by the code that
+-- interprets)
+::method test_signal_on_condition_info_interpret
+  seen = ''
+  rc = 'none'
+  signal on syntax name trapped
+  do
+    interpret "do; x = 1/0; finally; seen = seen '['condition('C') rc']'; end"
+  finally
+    seen = seen '['condition('C') rc']'
+  end
+  seen = seen 'no'
+  trapped:
+  self~assertEquals(' [ none] [ none]', seen)
+  self~assertEquals(42, rc)
+
