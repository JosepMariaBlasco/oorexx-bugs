+-- a non-SYNTAX condition RAISEd by a routine called through the API
+-- (CallRoutine, a fresh activation stack: no Rexx caller to get it) is
+-- reported to the native caller, as a SYNTAX error is
+::method TestCallRoutineCondition01
+  tester = .METHODTester~new
+  r = .routine~new("r", "raise user boom description 'd1' additional ('a1') return 'r1'")
+  report = tester~TestCallRoutineCondition(r, .array~new)
+  self~assertSame("r1", report[1])         -- the routine's result
+  self~assertTrue(report[2])               -- CheckCondition()
+  self~assertSame("USER BOOM", report[3])  -- GetConditionInfo()
+  self~assertSame("d1", report[4])
+  self~assertSame("a1", report[5])
+
+::method TestCallRoutineCondition02
+  tester = .METHODTester~new
+  -- RAISE without RETURN, RAISE PROPAGATE from a trap, RAISE ... EXIT
+  sources = .array~of( -
+    "raise user boom description 'd2'; return 'after'", -
+    "signal on user boom; raise user boom description 'd3'; return 'x'; boom: raise propagate", -
+    "raise user boom description 'd4' exit 'e4'")
+  expected = .array~of(.nil, .nil, "e4")
+  do i = 1 to sources~items
+    report = tester~TestCallRoutineCondition(.routine~new("r", sources[i]), .array~new)
+    self~assertSame(expected[i], report[1])
+    self~assertTrue(report[2])
+    self~assertSame("USER BOOM", report[3])
+    self~assertSame("d" || (i + 1), report[4])
+  end
+
+-- ... and it stops there, as with a Rexx caller: it is not raised again in the
+-- native code's own caller (the native code can raise it with RaiseCondition)
+::method TestCallRoutineCondition03
+  tester = .METHODTester~new
+  r = .routine~new("r", "raise user boom return 'r1'")
+  signal on user boom name raisedAgain
+  report = tester~TestCallRoutineCondition(r, .array~new)
+  self~assertTrue(report[2])
+  return
+raisedAgain:
+  self~fail("the condition was raised again in the native code's caller")
+
+-- unchanged: a SYNTAX error is reported and, not cleared, raised in the caller
+::method TestCallRoutineCondition04
+  tester = .METHODTester~new
+  r = .routine~new("r", "x = 1 + 'a'")
+  self~expectSyntax(41.1)
+  report = tester~TestCallRoutineCondition(r, .array~new)
+
+-- unchanged: through SendMessage from native code called by Rexx, the condition
+-- still reaches the Rexx caller below the native code
+::method TestSendMessageCondition01
+  tester = .METHODTester~new
+  signal on user boom name trapped
+  x = tester~TestSendMessage0(.RaiseBoom~new, "boom")
+  self~fail("USER BOOM did not reach the Rexx caller")
+trapped:
+  self~assertSame("USER BOOM", condition("C"))
+  self~assertSame("m1", condition("D"))
+
+-- DecodeConditionInfo on a condition other than SYNTAX (which has no CODE,
+-- and an RC only for ERROR and FAILURE, the command's return code)
+::method TestDecodeCondition01
+  tester = .METHODTester~new
+  report = tester~TestDecodeCondition(conditionOf("raise user boom description 'd' additional ('a')"))
+  self~assertSame("USER BOOM", report[1])
+  self~assertEquals(0, report[2])          -- code
+  self~assertEquals(0, report[3])          -- rc
+  self~assertSame("d", report[4])          -- description
+  self~assertSame(.nil, report[5])         -- additional: not an array, not given
+  self~assertFalse(report[6])              -- no condition left by decoding
+  report = tester~TestDecodeCondition(conditionOf("raise notready description 'n'"))
+  self~assertSame("NOTREADY", report[1])
+  self~assertSame("n", report[4])
+  self~assertFalse(report[6])
+
+-- the RC of ERROR and FAILURE can be any value: rc is it when it is a whole
+-- number, else 0
+::method TestDecodeCondition02
+  tester = .METHODTester~new
+  sources = .array~of("raise error 5", "raise error 0", "raise error (-3)", -
+    "raise error 127", "raise error 'abc'", "raise failure (-1)")
+  names = .array~of("ERROR", "ERROR", "ERROR", "ERROR", "ERROR", "FAILURE")
+  rcs = .array~of(5, 0, -3, 127, 0, -1)
+  do i = 1 to sources~items
+    report = tester~TestDecodeCondition(conditionOf(sources[i]))
+    self~assertSame(names[i], report[1], sources[i])
+    self~assertEquals(0, report[2], sources[i])
+    self~assertEquals(rcs[i], report[3], sources[i])
+    self~assertFalse(report[6], sources[i])
+  end
+
+-- RAISE allows any object as DESCRIPTION and ADDITIONAL: they are given only
+-- when they are a string and an array
+::method TestDecodeCondition03
+  tester = .METHODTester~new
+  report = tester~TestDecodeCondition(conditionOf("raise user boom array (1, 2)"))
+  self~assertTrue(report[5]~isA(.array))
+  self~assertEquals(2, report[5]~items)
+  report = tester~TestDecodeCondition(conditionOf("raise user boom description (2 + 3)"))
+  self~assertSame(.nil, report[4])
+  report = tester~TestDecodeCondition(conditionOf("raise user boom description (.array~of(1))"))
+  self~assertSame(.nil, report[4])
+
+-- unchanged: a SYNTAX condition
+::method TestDecodeCondition04
+  tester = .METHODTester~new
+  report = tester~TestDecodeCondition(conditionOf("x = 1 + 'a'"))
+  self~assertSame("SYNTAX", report[1])
+  self~assertEquals(41001, report[2])
+  self~assertEquals(41, report[3])
+  self~assertTrue(report[5]~isA(.array))
+  self~assertFalse(report[6])
+
 ::method TestSendMessage001
   tester = .METHODTester~new
   self~assertSame(3, tester~TestSendMessage0("abc", "LENGTH"))
@@ -3223,5 +3336,26 @@
 ::method makeString
   return "makeString"
 
+-- for TestSendMessageCondition01
+::class RaiseBoom
+::method boom
+  raise user boom description 'm1' return 'mr'
+
+-- for TestDecodeCondition0x: the condition object of what source raises
+::routine conditionOf
+  signal on user boom name caught
+  signal on error name caught
+  signal on failure name caught
+  signal on notready name caught
+  signal on syntax name caught
+  call raiseFrom arg(1)
+  return .nil
+caught:
+  return condition("O")
+
+::routine raiseFrom
+  -- RAISE in INTERPRET offers the condition to this routine's caller
+  interpret arg(1)
+
 
 ::options novalue syntax
