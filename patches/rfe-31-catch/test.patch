+
+-- a typed block with no clause for the condition: the error is shown and
+-- the rest of the line is not run
+::method test_trace_pause_typed_block_other
+  self~runAtTracePause('do; y = 1/0; catch user x; nop; end; r = r "after"', " body", .true)
+
+-- an error in the code of the typed CATCH clause is shown as well
+::method test_trace_pause_typed_block_clause_fails
+  self~runAtTracePause('do; y = 1/0; catch syntax; z = 2/0; end; r = r "after"', " body", .true)
+
+-- a condition other than SYNTAX is caught as well
+::method test_trace_pause_typed_block_novalue
+  self~runAtTracePause('do; r = r nosuchvar; catch novalue; r = r "nv"; end', " body nv", .false)
+
+::method test_trace_pause_interpreted_block
+  self~runAtTracePause('interpret "do; y = 1/0; catch syntax; r = r ''inner''; end"', " body inner", .false)
+
+::method runAtTracePause
+  use arg typed, expected, shown
+  source = .array~of( -
+    "r = ''", -
+    "do", -
+    "  trace ?r", -
+    "  r = r 'body'", -
+    "catch syntax", -
+    "  r = r 'caught'", -
+    "end", -
+    "trace off", -
+    "say 'r=['r']'", -
+    "exit", -
+    "pauseFails: return 1/0")
+  -- a name of its own for each test: a TemporaryTestFile deletes its file
+  -- when it is collected, which can happen after the next test has created
+  -- one with the same name
+  name = "catch_" || self~getName~lower
+  program = .TemporaryTestFile~new(self, name".tmp.rex")~create(source)
+  input = .TemporaryTestFile~new(self, name".tmp.txt")~create(.array~of(typed, "trace off"))
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName "<" input~quotedName "2>&1", output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC":" output~makeString)
+  -- the trace goes on after the pause, mixed with the output
+  line = ""
+  do l over output
+    if l~startsWith("r=[") then line = l
+  end
+  self~assertSame("r=["expected"]", line, output~makeString)
+  self~assertSame(shown, output~makeString~pos("Error 42.3") > 0, output~makeString)
+
