+::requires 'ooTest.frm' -- load the ooRexxUnit classes
+::requires 'FileUtils.cls' -- for issueCmd
+
+-- CATCH clauses of DO, LOOP and SELECT (prototype for RFE #31)
+::class "CATCH.testGroup" subclass ooTestCase public
+
+-- a caught condition ends the whole loop; the control variable keeps its value
+::method test_loop_ends
+  out = ''
+  do i = 1 to 5
+    out = out i
+    if i = 3 then x = 1/0
+  catch syntax
+    out = out 'c'
+  end
+  self~assertEquals(' 1 2 3 c 3', out i)
+
+-- no condition: the body runs into CATCH and the loop goes on
+::method test_no_condition
+  out = ''
+  loop i = 1 to 3
+    out = out i
+  catch syntax
+    out = out 'no'
+  end
+  self~assertEquals(' 1 2 3', out)
+
+::method test_simple_do_no_condition
+  out = 'body'
+  do
+    nop
+  catch syntax
+    out = 'catch'
+  end
+  self~assertEquals('body', out)
+
+-- several clauses, condition lists, the first match wins
+::method test_clauses
+  out = ''
+  do
+    call raiseUserTwo
+  catch user one, notready
+    out = 'one'
+  catch user two, user three
+    out = 'two'
+  catch any
+    out = 'any'
+  end
+  self~assertEquals('two', out)
+
+::method test_any
+  do
+    x = 1/0
+  catch any
+    out = condition('C')
+  end
+  self~assertEquals('SYNTAX', out)
+
+-- SIGL, RC, CONDITION() as after SIGNAL ON
+::method test_condition_info
+  do
+    line = .context~line; x = 1/0
+  catch syntax
+    out = condition('C') condition('I') rc condition('O')~code sigl
+  end
+  self~assertEquals('SYNTAX CATCH 42 42.3' line, out)
+
+-- SELECT
+::method test_select_when
+  select
+    when 1 then x = 1/0
+  catch syntax
+    out = condition('O')~code
+  end
+  self~assertEquals('42.3', out)
+
+::method test_select_otherwise
+  select
+    when 0 then nop
+    otherwise x = 1/0
+  catch syntax
+    out = 'otherwise'
+  end
+  self~assertEquals('otherwise', out)
+
+::method test_select_otherwise_no_condition
+  out = ''
+  select
+    when 0 then nop
+    otherwise out = 'otherwise'
+  catch syntax
+    out = 'catch'
+  end
+  self~assertEquals('otherwise', out)
+
+::method test_select_no_when_true
+  select
+    when 0 then nop
+  catch syntax
+    out = condition('O')~code
+  end
+  self~assertEquals('7.3', out)
+
+::method test_select_case
+  select case 1/0
+    when 1 then nop
+  catch syntax
+    out = 'case'
+  end
+  self~assertEquals('case', out)
+
+-- the clauses also cover the loop's own clause
+::method test_loop_control
+  do i = 1 to 1/0
+    nop
+  catch syntax
+    out = 'control'
+  end
+  self~assertEquals('control', out)
+
+-- blocks entered in the body are ended; an outer loop goes on
+::method test_nested
+  out = ''
+  do i = 1 to 3
+    do
+      do j = 1 to 2
+        if i = 2 then x = 1/0
+      end
+    catch syntax
+      out = out 'c'i
+    end
+    out = out i
+  end
+  self~assertEquals(' 1 c2 2 3', out)
+
+-- a condition raised in a CATCH clause goes to an outer block
+::method test_condition_in_clause
+  do
+    do
+      x = 1/0
+    catch syntax
+      out = 'inner'
+      y = 1/0
+    end
+  catch syntax
+    out = out 'outer'
+  end
+  self~assertEquals('inner outer', out)
+
+-- a SIGNAL ON enabled before the block is hidden by CATCH
+::method test_trap_before_block
+  signal on syntax name before
+  do
+    x = 1/0
+  catch syntax
+    out = 'catch'
+  end
+  signal off syntax
+  self~assertEquals('catch', out)
+  return
+before:
+  self~fail('the SIGNAL ON trap was used')
+
+-- inside its block the CATCH wins over a SIGNAL ON enabled there
+::method test_trap_inside_block
+  out = ''
+  do
+    signal on syntax name inside
+    x = 1/0
+  catch syntax
+    out = 'catch'
+  end
+  signal off syntax
+  self~assertEquals('catch', out)
+  return
+inside:
+  self~fail('the SIGNAL ON trap was used')
+
+-- the SIGNAL ON enabled inside the block is in effect after the block
+::method test_trap_inside_block_persists
+  out = ''
+  do
+    signal on syntax name after
+  catch syntax
+    out = 'catch'
+  end
+  x = 1/0
+  self~fail('the SIGNAL ON trap was not used')
+after:
+  self~assertEquals('', out)
+  self~assertEquals('SIGNAL', condition('I'))
+
+-- SIGNAL OFF inside the block makes no difference
+::method test_signal_off_inside_block
+  do
+    signal on syntax name inside
+    signal off syntax
+    x = 1/0
+  catch syntax
+    out = 'catch'
+  end
+  self~assertEquals('catch', out)
+  return
+inside:
+  self~fail('the SIGNAL ON trap was used')
+
+-- inside its block the CATCH wins over a CALL ON enabled there, and the
+-- CALL ON is in effect after the block
+::method test_call_on_inside_block
+  out = ''
+  do
+    call on user u5 name called
+    call raiseUserU5
+    out = out 'resumed'
+  catch user u5
+    out = out 'catch'
+  end
+  self~assertEquals(' catch', out)
+  call raiseUserU5
+  out = out 'resumed'
+  call off user u5
+  self~assertEquals(' catch called resumed', out)
+  return
+called:
+  out = out 'called'
+  return
+
+-- a SIGNAL ON enabled by an INTERPRET in the block does not win either
+::method test_interpret_trap_inside_block
+  out = ''
+  do
+    interpret 'signal on syntax name inside; x = 1/0'
+  catch syntax
+    out = 'catch'
+  end
+  signal off syntax
+  self~assertEquals('catch', out)
+  return
+inside:
+  self~fail('the SIGNAL ON trap was used')
+
+-- internal routines are covered; SIGL is the line of the CALL
+::method test_internal_routine
+  do
+    line = .context~line; call divide
+  catch syntax
+    out = 'caught' sigl
+  end
+  self~assertEquals('caught' line, out)
+  return
+divide:
+  x = 1/0
+  return
+
+-- a trap of the internal routine itself wins
+::method test_internal_routine_trap
+  do
+    call trapping
+  catch syntax
+    out = 'catch'
+  end
+  self~assertEquals('routine', out)
+  return
+trapping:
+  signal on syntax name routineTrap
+  x = 1/0
+  return
+routineTrap:
+  out = 'routine'
+  return
+
+-- a trap that the internal routine inherits does not win: neither one
+-- enabled before the block nor one enabled inside it
+::method test_internal_routine_inherited_trap
+  signal on syntax name inherited
+  do
+    signal on syntax name inherited
+    call divide
+  catch syntax
+    out = 'catch'
+  end
+  signal off syntax
+  self~assertEquals('catch', out)
+  return
+divide:
+  x = 1/0
+  return
+inherited:
+  self~fail('the SIGNAL ON trap was used')
+
+-- the trap of an internal routine wins in the routines it calls too
+::method test_internal_routine_trap_nested
+  out = ''
+  do
+    call outerRoutine
+    out = out 'back'
+  catch syntax
+    out = out 'catch'
+  end
+  self~assertEquals(' routine back', out)
+  return
+outerRoutine:
+  signal on syntax name routineTrap
+  call innerRoutine
+  return
+innerRoutine:
+  x = 1/0
+  return
+routineTrap:
+  out = out 'routine'
+  signal off syntax
+  return
+
+-- a trap enabled by an INTERPRET in the internal routine is the routine's
+::method test_internal_routine_interpret_trap
+  do
+    call trapping
+  catch syntax
+    out = 'catch'
+  end
+  self~assertEquals('routine', out)
+  return
+trapping:
+  interpret 'signal on syntax name routineTrap'
+  x = 1/0
+  return
+routineTrap:
+  out = 'routine'
+  return
+
+-- a CALL ON of the internal routine itself wins
+::method test_internal_routine_call_on
+  out = ''
+  do
+    call calling
+    out = out 'back'
+  catch user u5
+    out = out 'catch'
+  end
+  self~assertEquals(' called resumed back', out)
+  return
+calling:
+  call on user u5 name called
+  call raiseUserU5
+  out = out 'resumed'
+  return
+called:
+  out = out 'called'
+  return
+
+-- a block of the internal routine wins over the routine's own trap
+::method test_internal_routine_own_block
+  do
+    call catching
+  catch syntax
+    out = 'outer'
+  end
+  self~assertEquals('inner', out)
+  return
+catching:
+  signal on syntax name routineTrap
+  do
+    x = 1/0
+  catch syntax
+    out = 'inner'
+  end
+  return
+routineTrap:
+  out = 'trap'
+  return
+
+-- methods: SYNTAX propagates, NOTREADY does not
+::method test_method_syntax
+  do
+    .CatchHelper~new~divide
+  catch syntax
+    out = 'syntax'
+  end
+  self~assertEquals('syntax', out)
+
+::method test_method_notready
+  out = 'not caught'
+  do
+    .CatchHelper~new~notready
+  catch notready
+    out = 'caught'
+  end
+  self~assertEquals('not caught', out)
+
+-- INTERPRET
+::method test_interpret_parent_block
+  do
+    interpret 'x = 1/0'
+  catch syntax
+    out = 'parent'
+  end
+  self~assertEquals('parent', out)
+
+::method test_interpret_own_block
+  interpret 'do; x = 1/0; catch syntax; out = "inside"; end'
+  self~assertEquals('inside', out)
+
+-- LEAVE and ITERATE in a CATCH clause
+::method test_leave_unnamed_in_loop_clause
+  self~expectSyntax(28.6)
+  do i = 1 to 2
+    x = 1/0
+  catch syntax
+    leave
+  end
+
+::method test_iterate_owner
+  self~expectSyntax(28.7)
+  loop j = 1 to 2
+    x = 1/0
+  catch syntax
+    iterate j
+  end
+
+::method test_leave_owner_label
+  self~expectSyntax(28.6)
+  do label blk
+    x = 1/0
+  catch syntax
+    leave blk
+  end
+
+::method test_leave_outer
+  out = ''
+  do i = 1 to 3
+    do j = 1 to 3
+      if j = 2 then x = 1/0
+    catch syntax
+      out = out i'.'j
+      leave i
+    end
+  end
+  self~assertEquals(' 1.2 1', out i)
+
+::method test_leave_from_simple_do_clause
+  out = ''
+  do i = 1 to 3
+    do
+      if i = 2 then x = 1/0
+    catch syntax
+      leave
+    end
+    out = out i
+  end
+  self~assertEquals(' 1 2', out i)
+
+-- NOVALUE, LOSTDIGITS, NOSTRING are raised while a CATCH is active
+::method test_novalue
+  do
+    x = undefinedVariable
+  catch novalue
+    out = condition('D')
+  end
+  self~assertEquals('UNDEFINEDVARIABLE', out)
+
+::method test_lostdigits
+  do
+    numeric digits 5
+    x = 1234567 + 1
+  catch lostdigits
+    out = 'lostdigits'
+  end
+  self~assertEquals('lostdigits', out)
+
+::method test_nostring
+  do
+    x = .object~new || 'a'
+  catch nostring
+    out = 'nostring'
+  end
+  self~assertEquals('nostring', out)
+
+-- ::OPTIONS NOTREADY SYNTAX: CATCH NOTREADY wins, the option applies after the block
+::method test_options_syntax
+  src = .array~of( -
+    "do", -
+    "  x = linein('nonexistent.file.CATCH.testGroup')", -
+    "catch notready", -
+    "  out = 'notready'", -
+    "end", -
+    "signal on syntax", -
+    "x = linein('nonexistent.file.CATCH.testGroup')", -
+    "return out 'no syntax'", -
+    "syntax: return out condition('O')~code", -
+    "::options notready syntax")
+  self~assertEquals('notready 98.974', .routine~new('t', src)~call)
+
+-- ::OPTIONS ERROR SYNTAX and FAILURE SYNTAX: CATCH ERROR / FAILURE wins, as
+-- SIGNAL ON does, and the option applies after the block
+::method test_options_error_syntax
+  src = .array~of( -
+    "do", -
+    "  'exit 3'", -
+    "catch error", -
+    "  out = 'error' rc", -
+    "end", -
+    "signal on syntax", -
+    "'exit 3'", -
+    "return out 'no syntax'", -
+    "syntax: return out condition('O')~code", -
+    "::options error syntax")
+  self~assertEquals('error 3 98.970', .routine~new('t', src)~call)
+
+::method test_options_failure_syntax
+  src = .array~of( -
+    "do", -
+    "  address nonexistent.environment 'x'", -
+    "catch failure", -
+    "  out = condition('C')", -
+    "end", -
+    "signal on syntax", -
+    "address nonexistent.environment 'x'", -
+    "return out 'no syntax'", -
+    "syntax: return out condition('O')~code", -
+    "::options failure syntax")
+  self~assertEquals('FAILURE 98.971', .routine~new('t', src)~call)
+
+-- with a code, the option still applies when the code does not match
+::method test_options_error_syntax_code
+  src = .array~of( -
+    "do", -
+    "  'exit 3'", -
+    "catch error 4", -
+    "  return 'error 4'", -
+    "catch syntax", -
+    "  return condition('O')~code", -
+    "end", -
+    "::options error syntax")
+  self~assertEquals('98.970', .routine~new('t', src)~call)
+
+-- an untrapped FAILURE becomes ERROR, which CATCH ERROR gets under ERROR SYNTAX
+-- (the return code for an unknown environment is not the same everywhere)
+::method test_options_error_syntax_failure
+  src = .array~of( -
+    "do", -
+    "  address nonexistent.environment 'x'", -
+    "catch error", -
+    "  return condition('C')", -
+    "end", -
+    "::options error syntax")
+  self~assertEquals('ERROR', .routine~new('t', src)~call)
+
+-- ANY counts too
+::method test_options_error_syntax_any
+  src = .array~of( -
+    "do", -
+    "  'exit 3'", -
+    "catch any", -
+    "  return condition('C') rc", -
+    "end", -
+    "::options error syntax")
+  self~assertEquals('ERROR 3', .routine~new('t', src)~call)
+
+-- compiled programs keep the clauses (rexxc, encoded)
+::method test_compiled
+  src = .array~of( -
+    "do i = 1 to 3", -
+    "  if i = 2 then x = 1/0", -
+    "catch notready, syntax", -
+    "  return condition('C') i", -
+    "end")
+  source = SysTempFileName(.File~temporaryPath || .File~separator || 'catch-????.rex')
+  compiled = SysTempFileName(.File~temporaryPath || .File~separator || 'catch-????.rxc')
+  .stream~new(source)~~open("write replace")~~arrayout(src)~~close
+  address system 'rexxc "'source'" "'compiled'" -s -e'
+  s = .stream~new(compiled)~~open("read")
+  code = s~arrayin
+  s~close
+  call SysFileDelete source
+  call SysFileDelete compiled
+  self~assertEquals('SYNTAX 2', .routine~new('t', code)~call)
+
+-- the same with CATCH variable = condition: the variable survives
+::method test_compiled_variable
+  src = .array~of( -
+    "do i = 1 to 3", -
+    "  if i = 2 then x = 1/0", -
+    "catch c = notready, syntax", -
+    "  return c~condition c~code i", -
+    "end")
+  source = SysTempFileName(.File~temporaryPath || .File~separator || 'catch-????.rex')
+  compiled = SysTempFileName(.File~temporaryPath || .File~separator || 'catch-????.rxc')
+  .stream~new(source)~~open("write replace")~~arrayout(src)~~close
+  address system 'rexxc "'source'" "'compiled'" -s -e'
+  s = .stream~new(compiled)~~open("read")
+  code = s~arrayin
+  s~close
+  call SysFileDelete source
+  call SysFileDelete compiled
+  self~assertEquals('SYNTAX 42.3 2', .routine~new('t', code)~call)
+
+-- CATCH variable = condition [, condition]...: the variable gets the
+-- condition object when the clause starts to run (as in NetRexx's
+-- CATCH variable = exception)
+::method test_variable
+  do
+    x = 1/0
+  catch c = syntax
+    self~assertSame("SYNTAX", c~condition)
+    self~assertSame("42.3", c~code)
+    self~assertSame("CATCH", c~instruction)
+    self~assertSame(c~code, condition("O")~code)
+  end
+  self~assertSame("SYNTAX", c~condition)
+
+::method test_variable_list
+  do
+    call raiseUserTwo
+  catch e = user one, user two, syntax
+    r = e~condition
+  end
+  self~assertSame("USER TWO", r)
+
+::method test_variable_any
+  do
+    call raiseUserTwo
+  catch e = any
+    r = e~condition
+  end
+  self~assertSame("USER TWO", r)
+
+::method test_variable_stem
+  s. = 0
+  do
+    call raiseUserTwo
+  catch s. = any
+    nop
+  end
+  self~assertSame("USER TWO", s.zz~condition)
+
+::method test_variable_compound
+  k = 7
+  do
+    x = 1/0
+  catch c.k = syntax
+    nop
+  end
+  self~assertSame("42.3", c.7~code)
+
+-- only the clause that runs sets its variable
+::method test_variable_other_clause
+  drop a b
+  do
+    x = 1/0
+  catch a = notready
+    nop
+  catch b = syntax
+    nop
+  end
+  self~assertSame("A", a)
+  self~assertSame("SYNTAX", b~condition)
+
+-- a clause without a variable sets none
+::method test_variable_none
+  drop c
+  do
+    x = 1/0
+  catch syntax
+    nop
+  end
+  self~assertSame("C", c)
+
+-- the variable may have the name of a condition
+::method test_variable_named_syntax
+  do
+    x = 1/0
+  catch syntax = syntax
+    r = syntax~code
+  end
+  self~assertSame("42.3", r)
+
+-- a block inside a loop: the clause runs, and sets its variable, each time
+::method test_variable_loop
+  do i = 1 to 2
+    do
+      x = i / 0
+    catch c = syntax
+      r = c~code
+    end
+  end
+  self~assertSame("42.3", r)
+  self~assertSame(3, i)
+
+::method test_variable_number
+  self~assertSyntaxError(31.2, .array~of("do", "nop", "catch 1x = syntax", "end"))
+
+::method test_variable_period
+  self~assertSyntaxError(31.3, .array~of("do", "nop", "catch .x = syntax", "end"))
+
+::method test_variable_no_condition
+  self~assertSyntaxError(20.936, .array~of("do", "nop", "catch c =", "end"))
+
+::method test_variable_bad_condition
+  self~assertSyntaxError(25.939, .array~of("do", "nop", "catch c = foo", "end"))
+
+::method test_variable_strict_equal
+  self~assertSyntaxError(25.939, .array~of("do", "nop", "catch c == syntax", "end"))
+
+-- CATCH SYNTAX number, ERROR errorcode, FAILURE failurecode, as on RAISE:
+-- the clause catches the condition only when it has that code
+::method test_code_syntax_minor
+  do
+    x = 1/0
+  catch syntax 42.3
+    r = "42.3"
+  end
+  self~assertSame("42.3", r)
+
+-- a number with no minor part catches every error with that number
+::method test_code_syntax_major
+  do
+    x = 1/0
+  catch syntax 42
+    r = condition('O')~code
+  end
+  self~assertSame("42.3", r)
+
+-- another code does not catch: the next clause, or the next block
+::method test_code_syntax_other_clause
+  do
+    x = 1/0
+  catch syntax 42.1
+    r = "42.1"
+  catch syntax 41
+    r = "41"
+  catch syntax
+    r = "any syntax"
+  end
+  self~assertSame("any syntax", r)
+
+::method test_code_syntax_outer_block
+  r = ""
+  do
+    do
+      x = 1/0
+    catch syntax 40
+      r = r "inner"
+    end
+    r = r "not here"
+  catch syntax 42
+    r = r "outer"
+  end
+  self~assertSame(" outer", r)
+
+::method test_code_syntax_not_caught
+  self~expectSyntax(42.3)
+  do
+    x = 1/0
+  catch syntax 41, syntax 42.1
+    nop
+  end
+
+-- the first clause that catches wins: the general one comes last
+::method test_code_syntax_order
+  do
+    x = 1/0
+  catch syntax
+    r = "general"
+  catch syntax 42.3
+    r = "42.3"
+  end
+  self~assertSame("general", r)
+
