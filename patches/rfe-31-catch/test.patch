+-- Child processes: the condition crosses stack frames (internal routines,
+-- a routine, INTERPRET) and a garbage collection runs between the catch and
+-- the code of the clause, so that a crash cannot take the test suite with it.
+::method test_child_internal_routine_gc
+  source = .array~of( -
+    "n = 0", -
+    "do i = 1 to 50", -
+    "  do", -
+    "    call sub i", -
+    "  catch syntax", -
+    "    call gc", -
+    "    if condition('O')~code = 42.3 then n += 1", -
+    "  end", -
+    "end", -
+    "say 'n='n", -
+    "exit", -
+    "sub: procedure", -
+    "  call deeper arg(1)", -
+    "  return", -
+    "deeper:", -
+    "  do j = 1 to 3", -
+    "    if j = 2 then x = arg(1) / 0", -
+    "  end", -
+    "  return")
+  program = .TemporaryTestFile~new(self, "catch_internal.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("n=50", output~lastItem)
+
+::method test_child_interpret_routine_gc
+  source = .array~of( -
+    "m = 0", -
+    "do i = 1 to 50", -
+    "  do", -
+    "    interpret 'call raiser i'", -
+    "  catch user bad", -
+    "    call gc", -
+    "    if condition('D') = 'boom' i then m += 1", -
+    "  end", -
+    "end", -
+    "say 'm='m", -
+    "exit", -
+    "::routine raiser", -
+    "  raise user bad description ('boom' arg(1))")
+  program = .TemporaryTestFile~new(self, "catch_interpret.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("m=50", output~lastItem)
+
+::method test_child_interpret_own_block_method
+  source = .array~of( -
+    "k = 0", -
+    "do i = 1 to 50", -
+    "  interpret 'do; .h~new~m; catch syntax; call gc; k += 1; end'", -
+    "end", -
+    "say 'k='k", -
+    "::class h", -
+    "::method m", -
+    "  loop 3", -
+    "    x = .nil~noSuchMethod", -
+    "  end")
+  program = .TemporaryTestFile~new(self, "catch_interpret_method.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("k=50", output~lastItem)
+
