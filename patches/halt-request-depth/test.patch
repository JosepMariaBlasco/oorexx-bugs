@@ -1138,6 +1138,52 @@
   .CommandHandler~deregister("rc-stack")
   self~assertSame(0, .CommandHandler~handlers("rc-stack")~items)
 
+::method test_HaltThread_caller
+  -- a halt that a native routine asks for with HaltThread() is its caller's,
+  -- taken at the end of the clause
+  signal on halt name halted
+  signal on syntax name syntax
+  x = TestHaltThread()
+  nop
+  self~fail("no HALT")
+halted:
+  self~assertSame("HALT", condition("C"))
+  return
+syntax:
+  self~fail("SYNTAX" condition("O")~code "instead of HALT")
+
+::method test_HaltThread_not_a_later_method
+  -- bug #2124 follow-up: nor is it taken by a Rexx method that the same
+  -- clause runs afterwards, at the depth where the native routine was
+  signal on halt name halted
+  signal on syntax name syntax
+  x = TestHaltThread() || .HaltSibling~value
+  nop
+  self~fail("no HALT")
+halted:
+  self~assertSame("HALT", condition("C"))
+  return
+syntax:
+  self~fail("SYNTAX" condition("O")~code "instead of HALT")
+
+::method test_HaltThread_command_handler
+  -- bug #2124 follow-up: a halt that a native COMMAND method asks for is the
+  -- issuer's, not CommandContext~finish's (run after COMMAND returns)
+  .CommandHandler~register("halt-native", .HaltingHandler~new)
+  signal on halt name halted
+  signal on syntax name syntax
+  address "halt-native" "anything"
+  nop
+  .CommandHandler~deregister("halt-native")
+  self~fail("no HALT")
+halted:
+  .CommandHandler~deregister("halt-native")
+  self~assertSame("HALT", condition("C"))
+  return
+syntax:
+  .CommandHandler~deregister("halt-native")
+  self~fail("SYNTAX" condition("O")~code "instead of HALT")
+
 ::method test_StackCommandEnvironment_new_name
   -- on a name with no handler it is simply the environment
   self~assertSame(.true, TestStackCommandEnvironment("rc-stack-new", "direct"))
@@ -2237,6 +2283,15 @@
   return "makeString"
 
 
+-- a Rexx method with no HALT trap (bug #2124 follow-up)
+::class HaltSibling
+::method value class
+  return "x"
+
+-- a native COMMAND that asks for a halt with HaltThread() and returns 5
+::class HaltingHandler inherit CommandHandler
+::method command external "LIBRARY orxmethod TestHaltThreadCommand"
+
 -- answers RC 42 to every command (RFE #882)
 ::class ConstantHandler inherit CommandHandler
 ::method command
