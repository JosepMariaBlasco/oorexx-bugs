+-- a substitution value whose STRING method raises an error segfaulted; the
+-- error must reach the program.  In a child process, so that a crash cannot
+-- take the test suite with it.
+::method test_string_raises
+  source = .array~of( -
+    "signal on syntax", -
+    "x = SysFormatMessage('&1', .array~of(.raiser~new))", -
+    "say 'not trapped'", -
+    "exit", -
+    "syntax: say 'trapped' condition('o')~code", -
+    "::class raiser", -
+    "::method string", -
+    "  raise syntax 93.900 array('raised')")
+  program = .TemporaryTestFile~new(self, "format_string_raises.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(1, output~items, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("trapped 93.900", output[1])
+
+
 ::options novalue error
