   self~assertTrue(output~hasItem("Name=VAR, Value='" || longValue || "'"))
 
+-- a variable whose STRING method raises an error segfaulted, even under
+-- SIGNAL ON SYNTAX; the error must reach the program.  A simple variable,
+-- a stem default value and a compound variable, in a child process, so
+-- that a crash cannot take the test suite with it.
+::method test_string_raises
+  source = .array~of( -
+    "call simple", -
+    "call stemDefault", -
+    "call compound", -
+    "exit", -
+    "simple: procedure", -
+    "  signal on syntax name trapSimple", -
+    "  a = 'first'", -
+    "  b = .raiser~new", -
+    "  call SysDumpVariables", -
+    "  say 'not trapped'", -
+    "  return", -
+    "trapSimple: say 'trapped' condition('o')~code", -
+    "  return", -
+    "stemDefault: procedure", -
+    "  signal on syntax name trapStem", -
+    "  s. = .raiser~new", -
+    "  call SysDumpVariables", -
+    "  say 'not trapped'", -
+    "  return", -
+    "trapStem: say 'trapped' condition('o')~code", -
+    "  return", -
+    "compound: procedure", -
+    "  signal on syntax name trapCompound", -
+    "  s.1 = .raiser~new", -
+    "  call SysDumpVariables", -
+    "  say 'not trapped'", -
+    "  return", -
+    "trapCompound: say 'trapped' condition('o')~code", -
+    "  return", -
+    "::class raiser", -
+    "::method string", -
+    "  raise syntax 93.900 array('raised')")
+  program = .TemporaryTestFile~new(self, "dump_string_raises.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  results = .array~new
+  do line over output
+    if line~word(1) == "trapped" | line == "not trapped" then
+      results~append(line)
+  end
+  self~assertSame(3, results~items, "rexx ended with rc" theRC "after" results~items "results")
+  do line over results
+    self~assertSame("trapped 93.900", line)
+  end
+
 ::routine DumpVariables
   -- no local variables are declared here
   call SysDumpVariables arg(1)
