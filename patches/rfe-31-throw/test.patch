--- a/ooRexx/API/oo/METHOD.testGroup	(revision 13540)
+++ b/ooRexx/API/oo/METHOD.testGroup	(working copy)
@@ -3643,6 +3643,51 @@
   self~assertSame("a SCOPED3", tester~TestSendMessageScoped(o, "STRING", .Object,  .Array~new(0)))
 
 
+-- THROW (RFE #31): a thrown condition crosses native code as a SYNTAX error
+-- does.  CallRoutine returns, and the native code sees the condition...
+::method TestCallRoutineThrown01
+  tester = .METHODTester~new
+  r = .routine~new("r", "throw user boom description 'd1' additional ('a1')")
+  c = tester~TestCallRoutineConditionObject(r, .array~new)
+  self~assertSame("USER BOOM", c~condition)
+  self~assertSame("d1", c~description)
+  self~assertSame("a1", c~additional)
+  self~assertTrue(c~thrown)
+
+-- ... and if it does not clear it, it is thrown again in its Rexx caller
+::method TestCallRoutineThrown02
+  tester = .METHODTester~new
+  r = .routine~new("r", "throw user boom description 'd2'")
+  do
+    report = tester~TestCallRoutineCondition(r, .array~new)
+    self~fail("not thrown again in the Rexx caller")
+  catch c = user boom
+    self~assertSame("d2", c~description)
+    self~assertTrue(c~thrown)
+  end
+
+-- through SendMessage: the native code sees it right after the send
+::method TestSendMessageThrown01
+  tester = .METHODTester~new
+  report = tester~TestSendMessageConditionObject(.ThrowBoom~new, "BOOM", .array~new)
+  self~assertTrue(report[1])
+  self~assertSame("USER BOOM", report[2]~condition)
+  self~assertTrue(report[2]~thrown)
+
+-- ... and a Rexx caller below the native code catches it
+::method TestSendMessageThrown02
+  tester = .METHODTester~new
+  do
+    x = tester~TestSendMessage0(.ThrowBoom~new, "boom")
+    self~fail("not thrown again in the Rexx caller")
+  catch c = user boom
+    self~assertTrue(c~thrown)
+  end
+
+::class ThrowBoom
+::method boom
+  throw user boom description 'm1'
+
 -- test class for SendMessageScoped
 ::class Scoped1
 ::constant string "S1"
