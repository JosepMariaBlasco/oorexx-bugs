+            class SendingTraceOutput
+            {
+             public:
+                SendingTraceOutput(bool &f) : flag(f) { flag = true; }
+                ~SendingTraceOutput() { flag = false; }
+             private:
+                bool &flag;
+            } sending(sendingTraceOutput);
+
