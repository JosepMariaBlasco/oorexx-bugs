===================================================================
--- a/ooRexx/base/bif/BuiltinArgumentErrors.testGroup	(nonexistent)
+++ b/ooRexx/base/bif/BuiltinArgumentErrors.testGroup	(working copy)
@@ -0,0 +1,138 @@
+#!/usr/bin/env rexx
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
