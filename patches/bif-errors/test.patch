+/* Redistributions of source code must retain the above copyright             */
+/* notice, this list of conditions and the following disclaimer.              */
+/* Redistributions in binary form must reproduce the above copyright          */
+/* notice, this list of conditions and the following disclaimer in            */
+/* the documentation and/or other materials provided with the distribution.   */
+/*                                                                            */
+/* Neither the name of Rexx Language Association nor the names                */
+/* of its contributors may be used to endorse or promote products             */
+/* derived from this software without specific prior written permission.      */
+/*                                                                            */
+/* THIS SOFTWARE IS PROVIDED BY THE COPYright HOLDERS AND CONTRIBUTORS        */
+/* "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT          */
+/* LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS          */
+/* FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYright   */
+/* OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,      */
+/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+/*                                                                            */
+  parse source . . s
+  group = .TestGroup~new(s)
+  group~add(.BuiltinArgumentErrors.testGroup)
+
+  if group~isAutomatedTest then return group
+
+  testResult = group~suite~execute~~print
+
+return testResult
+
+::requires 'ooTest.frm' -- load the ooRexxUnit classes
+
+-- Built-in functions that delegate the checking of their arguments to the
+-- String methods that implement them must report the function's errors
+-- (40.xxx, with the function's name and argument position), not the
+-- methods' (93.xxx, with method positions).  The methods themselves, and
+-- any code a function reaches through a message (here, a STRING method),
+-- keep their method errors.
+-- [bugs:#2006] [bugs:#2007] [bugs:#2010] [bugs:#2015] [bugs:#2016]
+::class "BuiltinArgumentErrors.testGroup" subclass ooTestCase public
+
+-- check code, function name and argument position (ADDITIONAL 1 and 2)
+::method checkError
+  use strict arg expression, code, name, position
+  co = raised(expression)
+  self~assertNotSame(.nil, co, expression "should raise" code)
+  self~assertSame(code, co~code, expression)
+  self~assertSame(name, co~additional[1], expression)
+  self~assertSame(position, co~additional[2]~string, expression)
+
+::method test_length_and_position
+  self~checkError('left("abc", -1)',              "40.13", "LEFT",      "2")
+  self~checkError('substr("abc", 1, -1)',         "40.13", "SUBSTR",    "3")
+  self~checkError('substr("abc", 0)',             "40.14", "SUBSTR",    "2")
+  self~checkError('word("abc", 0)',               "40.14", "WORD",      "2")
+  self~checkError('translate("abc",,,, 1, -1)',   "40.13", "TRANSLATE", "6")
+  self~checkError('copies("abc", -1)',            "40.13", "COPIES",    "2")
+  self~checkError('trunc(5, -1)',                 "40.13", "TRUNC",     "2")
+  self~checkError('format(5, -1)',                "40.13", "FORMAT",    "2")
+
+::method test_target_is_argument_2
+  self~checkError('pos("b", "abc", 0)',           "40.14", "POS",       "3")
+  self~checkError('lastpos("b", "abc", 1, -1)',   "40.13", "LASTPOS",   "4")
+  self~checkError('insert("x", "abc", -1)',       "40.13", "INSERT",    "3")
+  self~checkError('overlay("x", "abc", 0)',       "40.14", "OVERLAY",   "3")
+  self~checkError('wordpos("a", "a b", 0)',       "40.14", "WORDPOS",   "3")
+  self~checkError('changestr("b", "abc", "x", -1)', "40.13", "CHANGESTR", "4")
+
+::method test_options
+  self~checkError('strip("abc", "X")',            "40.904", "STRIP",    "2")
+  self~checkError('verify("abc", "a", "X")',      "40.904", "VERIFY",   "3")
+  self~checkError('datatype("abc", "+")',         "40.904", "DATATYPE", "2")
+
+::method test_number_target
+  self~checkError('abs("A")',                     "40.11", "ABS",       "1")
+  self~checkError('sign("A")',                    "40.11", "SIGN",      "1")
+  self~checkError('trunc("A")',                   "40.11", "TRUNC",     "1")
+  self~checkError('format("A")',                  "40.11", "FORMAT",    "1")
+  self~checkError('max("A", 1)',                  "40.11", "MAX",       "1")
+  self~checkError('min("A", 1)',                  "40.11", "MIN",       "1")
+
+::method test_max_min_arguments
+  -- [bugs:#2006]: the missing argument used to be "argument 0", and a
+  -- non-numeric one was counted from the second argument
+  self~checkError('max(1, , 2)',                  "40.5",  "MAX",       "2")
+  self~checkError('max(1, 2, , 3)',               "40.5",  "MAX",       "3")
+  self~checkError('min(1.5, , 2)',                "40.5",  "MIN",       "2")
+  self~checkError('max(5, "A")',                  "40.11", "MAX",       "2")
+  self~checkError('min(5.5, 2, "A")',             "40.11", "MIN",       "3")
+
+::method test_methods_keep_method_errors
+  self~assertSame("93.923", raised('"abc"~left(-1)')~code)
+  self~assertSame("93.924", raised('"abc"~substr(0)')~code)
+  self~assertSame("93.915", raised('"abc"~strip("X")')~code)
+  self~assertSame("93.943", raised('"A"~abs')~code)
+  self~assertSame("93.904", raised('5~max(2, "A")')~code)
+  -- the integer and the number string paths agree, and count from 1
+  do expression over '5~max(, 2)', '5.5~max(, 2)', '5~min(, 2)', '5.5~min(, 2)'
+    co = raised(expression)
+    self~assertSame("93.903", co~code, expression)
+    self~assertSame("1", co~additional[1]~string, expression)
+  end
+
+::method test_code_reached_through_a_message
+  -- LEFT asks its argument for a string; that STRING method's own error
+  -- is a method error, and must stay one
+  self~assertSame("93.923", raised('left(.MakesAMethodError~new, 2)')~code)
+  self~assertSame("93.923", raised('abs(.MakesAMethodError~new)')~code)
+
+
+-- the condition object of the SYNTAX error the expression raises, or .nil
+::routine raised
+  use strict arg expression
+  signal on syntax
+  interpret "x =" expression
+  return .nil
+syntax:
+  return condition("o")
+
+::class MakesAMethodError
+::method string
+  return "abc"~left(-1)
