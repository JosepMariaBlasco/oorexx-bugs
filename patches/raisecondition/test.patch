+-- RaiseCondition: as with the RAISE instruction, an untrapped HALT or
+-- NOMETHOD condition is an error
+::method testRaiseConditionHaltNomethod
+  tester = .METHODTester~new
+  -- trapped: as before
+  c = tester~TestRaiseConditionX("HALT", "halt description")
+  self~assertSame("HALT", c~condition)
+  self~assertSame("halt description", c~description)
+  c = tester~TestRaiseConditionX("NOMETHOD")
+  self~assertSame("NOMETHOD", c~condition)
+  -- not trapped
+  c = tester~TestRaiseConditionSyntaxX("HALT")
+  self~assertNotNil(c, "an untrapped HALT was lost")
+  self~assertSame(4.1, c~code)
+  c = tester~TestRaiseConditionSyntaxX("NOMETHOD")
+  self~assertNotNil(c, "an untrapped NOMETHOD was lost")
+  self~assertSame(97.5, c~code)
+  c = tester~TestRaiseConditionSyntaxX("NOMETHOD", "FOO", .array~of("receiver"))
+  self~assertNotNil(c, "an untrapped NOMETHOD was lost")
+  self~assertSame(97.1, c~code)
+  -- other conditions are not affected: the method returns
+  c = tester~TestRaiseConditionSyntaxX("USER MINE")
+  self~assertSame(.nil, c)
+  self~assertSame(.true, tester~TestGetObjectVariableOrNil("CONTINUE"))
+
+-- RaiseCondition cannot raise SYNTAX (it has no error number); it crashed
+::method testRaiseConditionSyntax
+  tester = .METHODTester~new
+  c = tester~TestRaiseConditionX("SYNTAX", "no number")
+  self~assertSame(93.900, c~code)
+
+
+
 ::method testSendMessageScoped
   tester = .METHODTester~new
   o = .Scoped3~new
