+-- returns the condition object of whatever the call raised, or .nil
+::method TestRaiseConditionX
+  signal on syntax name trapped
+  signal on any name trapped
+  forward message("TestRaiseCondition") continue
+  return .nil
+
+  trapped:
+     return condition('o')
+
+-- traps SYNTAX only
+::method TestRaiseConditionSyntaxX
+  signal on syntax
+  forward message("TestRaiseCondition") continue
+  return .nil
+
+  syntax:
+     return condition('o')
+
 ::method TestRaiseException0X
   signal on syntax
   forward message(TestRaiseException0) continue
