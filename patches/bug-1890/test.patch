+-- [bugs:#1890] Array delete/insert issues
+::method test_array_delete_sparse_index
+  self~expectSyntax("98.975")   -- used to crash
+  .Array~new~delete(.array~of(,1))
+
+::method test_array_insert_sparse_index
+  self~expectSyntax("98.975")   -- used to crash
+  .Array~new~insert("i", .array~of(,1))
+
+::method test_array_insert_multi_index_empty
+  -- used to turn the empty array into a 2x2 one and return 5
+  self~expectSyntax("93.926")
+  .Array~new~insert("i", .array~of(2,2))
+
+::method test_array_insert_multi_index_empty_unchanged
+  a = .Array~new
+  signal on syntax
+  a~insert("i", .array~of(2,2))
+  self~fail("INSERT with two subscripts raised no error")
+syntax:
+  self~assertSame(93.926, condition("o")~code)
+  self~assertSame(0, a~dimension)
+  self~assertSame(0, a~items)
+
+::method test_array_delete_multi_index_empty
+  -- used to go on with an unset position
+  self~expectSyntax("93.926")
+  .Array~new~delete(.array~of(2,2))
+
 ::method "test_equivalent"
   -- empty arrays of two different sizes...still equivalent
   self~assertTrue(.array~new(10)~equivalent(.array~new(20)))
