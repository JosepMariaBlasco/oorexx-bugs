+parse source . . s
+
+group = .TestGroup~new(s)
+-- macOS has no sem_xxx functions, so RexxUtil has no Sys*EventSem functions there
+group~restrictOS(group~knownOSes~difference(.set~of("DARWIN", "MACOSX")))
+group~add(.SysEventSem.testGroup)
+if group~isAutomatedTest then
+  return group
+else
+  return group~suite~execute~~print
+
+
+::requires 'ooTest.frm'
+::requires 'FileUtils.cls' -- for issueCmd
+
+::class SysEventSem.testGroup subclass ooTestCase public
+
+::method test_post_wait_reset_close
+  h = SysCreateEventSem()
+  self~assertFalse(h == "", "no handle")
+  self~assertSame(0, SysPostEventSem(h))
+  self~assertSame(0, SysWaitEventSem(h, 1000))
+  self~assertSame(0, SysResetEventSem(h))
+  self~assertSame(0, SysCloseEventSem(h))
+
+-- a handle that was closed was used as an address on Unix and crashed; it
+-- now answers 6 (invalid handle), as on Windows; run in a child process
+::method test_closed_handle
+  source = .array~of( -
+    "h = SysCreateEventSem()", -
+    "call SysCloseEventSem h", -
+    "say SysPostEventSem(h) SysResetEventSem(h) SysWaitEventSem(h, 100) SysCloseEventSem(h)")
+  program = .TemporaryTestFile~new(self, "SysEventSem_closed.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC)
+  self~assertSame(1, output~items, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("6 6 6 6", output[1])
+
+-- a number that no SysCreateEventSem answered (a handle rounded by arithmetic,
+-- or made up) was used as an address on Unix and crashed; it now answers 6.
+-- Only on Unix: on Windows such a number may be another handle of the process
+::method test_made_up_handle
+  if .ooRexxUnit.OSName == "WINDOWS" then return
+  source = .array~of( -
+    "h = SysCreateEventSem()", -
+    "say SysPostEventSem(h + 8) SysResetEventSem(12345678) SysWaitEventSem(0, 100) SysCloseEventSem(h + 8)", -
+    "say SysPostEventSem(h) SysWaitEventSem(h, 1000) SysCloseEventSem(h)")
+  program = .TemporaryTestFile~new(self, "SysEventSem_made_up.tmp.rex")~create(source)
+  output = .array~new
+  theRC = issueCmd("rexx" program~quotedName, output)
+  self~assertSame(0, theRC, "rexx ended with rc" theRC)
+  self~assertSame(2, output~items, "rexx ended with rc" theRC "after" output~items "lines")
+  self~assertSame("6 6 6 6", output[1])
+  self~assertSame("0 0 0", output[2], "the real handle still works")

