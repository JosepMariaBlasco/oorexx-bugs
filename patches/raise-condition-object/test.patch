+-- these return the condition object of whatever the call raised, or .nil
+::method TestRaiseConditionObjectX
+  signal on syntax name trapped
+  signal on any name trapped
+  forward message("TestRaiseConditionObject") continue
+  return .nil
+
+  trapped:
+     return condition('o')
+
+::method TestRaiseConditionX
+  signal on syntax name trapped
+  signal on any name trapped
+  forward message("TestRaiseCondition") continue
+  return .nil
+
+  trapped:
+     return condition('o')
+
+::method TestCallRoutineAndReraiseX
+  signal on syntax name trapped
+  signal on any name trapped
+  forward message("TestCallRoutineAndReraise") continue
+  return .nil
+
+  trapped:
+     return condition('o')
+
+-- these trap SYNTAX only
+::method TestRaiseConditionObjectSyntaxX
+  signal on syntax
+  forward message("TestRaiseConditionObject") continue
+  return .nil
+
+  syntax:
+     return condition('o')
+
+::method TestRaiseConditionSyntaxX
+  signal on syntax
+  forward message("TestRaiseCondition") continue
+  return .nil
+
+  syntax:
+     return condition('o')
+
