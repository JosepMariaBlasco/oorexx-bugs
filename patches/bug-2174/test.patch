+::routine raisableConditions
+  return .array~of("ERROR", "FAILURE", "HALT", "LOSTDIGITS", "NOMETHOD", -
+    "NOSTRING", "NOTREADY", "NOVALUE", "USER")
+
+-- the RESULT entry of the condition object, trapped with SIGNAL ON
+::routine signalOnResult
+  use arg cond, how
+  signal on any name trapped
+  call raiseWithValue cond, how, cond how
+  return "not trapped"
+trapped:
+  co = condition("O")
+  if \co~hasIndex("RESULT") then
+    return "no RESULT entry"
+  return co~result
+
+-- the RESULT entry of the condition object, trapped with CALL ON, and the
+-- result of the call
+::routine callOnResult
+  use arg cond, how
+  entry = "not trapped"
+  call on any name handler
+  value = raiseWithValue(cond, how, cond how)
+  return entry "/" value
+handler:
+  co = condition("O")
+  if \co~hasIndex("RESULT") then
+    entry = "no RESULT entry"
+  else
+    entry = co~result
+  return
+
+::routine raiseWithValue
+  use arg cond, how, value
+  if how = "RETURN" then select case cond
+    when "ERROR"      then raise error 1 return (value)
+    when "FAILURE"    then raise failure 1 return (value)
+    when "HALT"       then raise halt return (value)
+    when "LOSTDIGITS" then raise lostdigits return (value)
+    when "NOMETHOD"   then raise nomethod return (value)
+    when "NOSTRING"   then raise nostring return (value)
+    when "NOTREADY"   then raise notready return (value)
+    when "NOVALUE"    then raise novalue return (value)
+    when "USER"       then raise user u return (value)
+  end
+  else select case cond
+    when "ERROR"      then raise error 1 exit (value)
+    when "FAILURE"    then raise failure 1 exit (value)
+    when "HALT"       then raise halt exit (value)
+    when "LOSTDIGITS" then raise lostdigits exit (value)
+    when "NOMETHOD"   then raise nomethod exit (value)
+    when "NOSTRING"   then raise nostring exit (value)
+    when "NOTREADY"   then raise notready exit (value)
+    when "NOVALUE"    then raise novalue exit (value)
+    when "USER"       then raise user u exit (value)
+  end
+
+::routine raiseNoValue
+  raise user nothing
+
+
 ::options all syntax error condition failure condition
