+-- RAISE ... RETURN (value) and EXIT (value) put the value in the RESULT
+-- entry of the condition object, for every condition, not only SYNTAX
+::method test_RAISE_RETURN_result_signal_on
+  do cond over raisableConditions()
+    self~assertSame(cond "RETURN", signalOnResult(cond, "RETURN"), cond)
+  end
+
+::method test_RAISE_EXIT_result_signal_on
+  do cond over raisableConditions()
+    self~assertSame(cond "EXIT", signalOnResult(cond, "EXIT"), cond)
+  end
+
+-- under CALL ON, the value is also the result of the call, as before
+::method test_RAISE_RETURN_result_call_on
+  do cond over .array~of("ERROR", "FAILURE", "HALT", "NOTREADY", "USER")
+    self~assertSame(cond "RETURN" "/" cond "RETURN", callOnResult(cond, "RETURN"), cond)
+  end
+
+::method test_RAISE_EXIT_result_call_on
+  do cond over .array~of("ERROR", "FAILURE", "HALT", "NOTREADY", "USER")
+    self~assertSame(cond "EXIT" "/" cond "EXIT", callOnResult(cond, "EXIT"), cond)
+  end
+
+-- without RETURN or EXIT there is still no RESULT entry
+::method test_RAISE_no_value_no_result_entry
+  signal on user nothing name trapped
+  call raiseNoValue
+  self~fail("USER NOTHING not trapped")
+trapped:
+  self~assertFalse(condition("O")~hasIndex("RESULT"))
+
 
 -- test whether message inserts keep CR/LF unmasked, not masking as "?"
