--- a/ooRexx/base/bif/BuiltinArgumentErrors.testGroup	(revision 13366)
+++ b/ooRexx/base/bif/BuiltinArgumentErrors.testGroup	(working copy)
@@ -104,6 +104,24 @@
   self~checkError('max(5, "A")',                  "40.11", "MAX",       "2")
   self~checkError('min(5.5, 2, "A")',             "40.11", "MIN",       "3")
 
+-- [bugs:#2011] [bugs:#2014] [bugs:#2010]: the stream functions check their
+-- positions and counts themselves, whether the stream exists or not
+::method test_stream_functions
+  file = .File~new(.File~temporaryPath, "no-such-file-2011")~absolutePath
+  -- a file that does not exist, and one that does (this one)
+  do name over q(file), q(.context~package~name)
+    self~checkError('linein('name', 0)',        "40.14",  "LINEIN",  "2")
+    self~checkError('linein('name', 1, -1)',    "40.904", "LINEIN",  "3")
+    self~checkError('linein('name', 1, 3)',     "40.904", "LINEIN",  "3")
+    self~checkError('charin('name', -1)',       "40.14",  "CHARIN",  "2")
+    self~checkError('charin('name', 1, -1)',    "40.13",  "CHARIN",  "3")
+  end
+  self~checkError('charin(, , -1)',             "40.13",  "CHARIN",  "3")
+  self~checkError('lineout('q(file)', "x", 0)', "40.14",  "LINEOUT", "3")
+  self~checkError('charout('q(file)', "x", -1)', "40.14", "CHAROUT", "3")
+  call stream file, "c", "close"
+  call SysFileDelete file
+
 ::method test_methods_keep_method_errors
   self~assertSame("93.923", raised('"abc"~left(-1)')~code)
   self~assertSame("93.924", raised('"abc"~substr(0)')~code)
@@ -133,6 +151,10 @@
 syntax:
   return condition("o")
 
+-- a string as a Rexx literal
+::routine q
+  return '"'arg(1)~changeStr('"', '""')'"'
+
 ::class MakesAMethodError
 ::method string
   return "abc"~left(-1)
