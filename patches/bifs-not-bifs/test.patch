+/* OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,      */
+/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+  parse source . . fileSpec
+  group = .TestGroup~new(fileSpec)
+
+  group~add(.BuiltinSearchOrder.testGroup)
+
+  if group~isAutomatedTest then return group
+
+  testResult = group~suite~execute~~print
+
+return testResult
+
+::requires 'ooTest.frm' -- load the ooRexxUnit classes
+
+::class "BuiltinSearchOrder.testGroup" subclass ooTestCase public
+
+-- BEEP, DIRECTORY and FILESPEC are built-in functions like the others
+-- since 5.3.0; before, they were routines of the REXX package, searched
+-- for as external routines. Built-in functions come before external
+-- routines in the search order, so a ::ROUTINE of the same name does not
+-- replace them (only an internal label does), and calling them does not
+-- go through the CALL method of a security manager (bug #1885).
+
+::method test_routine_does_not_replace
+  cases = .Array~of( -
+    .Array~of("LENGTH",    "length('abc')",             3), -
+    .Array~of("FILESPEC",  "filespec('name', '/a/b.c')", "b.c"), -
+    .Array~of("DIRECTORY", "directory()",               qualify(".")), -
+    .Array~of("BEEP",      "beep(37, 0)",               "") -
+  )
+  do case over cases
+    r = .Routine~new("t", .Array~of("return" case[2], "::routine" case[1] "; return 'routine'"))
+    self~assertSame(case[3], r~call, case[2] "with a ::ROUTINE" case[1])
+  end
+
+::method test_internal_label_replaces
+  do name over "LENGTH", "FILESPEC", "DIRECTORY", "BEEP"
+    r = .Routine~new("t", .Array~of("return" name"('x', 'y')", name": return 'label'"))
+    self~assertSame("label", r~call, name)
+  end
+
+::method test_security_manager_1885
+  manager = .CallRecorder~new
+  do source over "length('abc')", "filespec('name', '/a/b.c')", "directory()", "beep(37, 0)"
+    r = .Routine~new("t", "return" source)
+    r~setSecurityManager(manager)
+    manager~calls = .Array~new
+    x = r~call
+    self~assertSame(0, manager~calls~items, source "should not reach the security manager's CALL method")
+  end
+
+-- RxFuncQuery, RxFuncAdd and RxFuncDrop answer for BEEP, DIRECTORY and
+-- FILESPEC what they answer for any other built-in function: there is no
+-- external function of that name (the routines the REXX package keeps for
+-- programs compiled by older releases are not reported)
+::method test_rxfunc
+  do name over "FILESPEC", "DIRECTORY", "BEEP"
+    self~assertSame(rxfuncquery("LENGTH"), rxfuncquery(name), "RxFuncQuery" name)
+    self~assertSame(1, rxfuncquery(name), "RxFuncQuery" name)
+    self~assertSame(rxfuncdrop("LENGTH"), rxfuncdrop(name), "RxFuncDrop" name)
+  end
+
+::class CallRecorder
+::attribute calls
+::method call
+  use arg info
+  self~calls~append(info~name)
+  return 0                      -- let the interpreter perform the call
+
+
+::options novalue error

