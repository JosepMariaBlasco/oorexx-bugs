+++ b/ooRexx/utilities/rexxc/rexxc.testGroup	(working copy)
@@ -270,6 +270,35 @@
   compiled~delete
 
 
+-- BEEP, DIRECTORY and FILESPEC are built-in functions since 5.3.0 (6.07);
+-- before, they were routines of the REXX package, so an older release has
+-- no code for them. A name that resolves to an internal label is not the
+-- built-in function.
+::method test_beep_directory_filespec_level
+  nl = .endOfLine
+  cases = .Array~of( -
+    .Array~of(60700, "x = beep(37, 0)"), -
+    .Array~of(60700, "call beep 37, 0"), -
+    .Array~of(60700, "x = directory()"), -
+    .Array~of(60700, "x = 'DIRECTORY'()"), -
+    .Array~of(60700, "x = filespec('n', 'a.b')"), -
+    .Array~of(60700, "call filespec 'n', 'a.b'"), -
+    .Array~of(60700, "call on halt name beep"), -
+    .Array~of(60500, "x = filespec('n', 'a.b')" || nl || "exit" || nl || "filespec: return 1"), -
+    .Array~of(60500, "call directory" || nl || "exit" || nl || "directory: return") -
+  )
+  source = .TemporaryTestFile~new(self, "test_bif_level.rex")
+  compiled = .TemporaryTestFile~new(self, "test_bif_level.rexc")
+  do case over cases
+    source~create(case[2])
+    address "" "rexxc" self~q(source~fullName) self~q(compiled~fullName) "-s" with output stem o. error stem e.
+    self~assertRc(0, rc, "rexxc expected to compile" case[2] "with rc 0")
+    self~assertSame(case[1], requiredLanguageLevel(compiled), "required language level of:" case[2])
+  end
+  source~delete
+  compiled~delete
+
+
 -- the language level stored in the header of a program compiled by rexxc:
