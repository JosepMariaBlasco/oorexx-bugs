 ::method 'test_18'
   self~assertSyntaxError(35.934, ("select case 1", "when 1,,2 then x = 1", "end"))
 
+-- bug #2018: a WHEN cannot be the instruction of an empty THEN.
+-- .routine~new only translates: the code must not run, as running it
+-- crashed the interpreter before the fix.
+::method 'test_when_then_when'
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", ("select case 2", "when 1 then", "when 2 then nop", "end"))
+
+::method 'test_when_then_when_match'
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", ("select case 1", "when 1 then", "when 2 then nop", "end"))
+
 ::method 'test_19'
   self~expectSyntax(7.3)
   select case 3
