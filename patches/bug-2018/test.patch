@@ -633,6 +633,34 @@
   -- END has no corresponding DO, LOOP, or SELECT
   self~assertSyntaxError(10.1, "select; when 1 then; end")
 
+-- bug #2018: a WHEN cannot be the instruction of an empty THEN.
+-- .routine~new only translates: the code must not run, as running it
+-- crashed the interpreter before the fix.
+::method test_select_when_then_when
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", ("select", "  when 0 then", "  when 1 then nop", "end"))
+
+::method test_select_when_then_when_true
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", ("select", "  when 1 then", "  when 1 then nop", "end"))
+
+::method test_select_when_then_null_when
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", "select; when 0 then; when 1 then nop; end")
+
+::method test_select_when_then_if_then_when
+  -- WHEN has no corresponding SELECT
+  self~expectSyntax(9.1)
+  .routine~new("test", "select; when 0 then if 1 then; when 1 then nop; end")
+
+::method test_select_when_then_otherwise
+  -- OTHERWISE has no corresponding SELECT
+  self~expectSyntax(9.2)
+  .routine~new("test", "select; when 0 then; otherwise nop; end")
+
 ::method test_select_minimum_required
   select
     when 1 then self~assertTrue(1)
