+::method raisesInClause
+  use arg log
+  do
+    return 'value'
+  finally
+    log~append('finally')
+    raise user oops
+  end
+
+::method propagatesInClause
+  use arg log
+  do
+    return 'value'
+  finally
+    log~append('finally')
+    do
+      x = 1/0
+    catch syntax
+      raise propagate
+    end
+  end
+
 ::method forwards
   use arg log
   do
-    forward message 'target'
+    forward continue message 'target'
+    return result
   finally
     log~append('finally')
   end
 
+::method forwardsToFailure
+  use arg log
+  do
+    forward continue message 'failingTarget'
+    return result
+  catch syntax
+    log~append('catch' condition('O')~code)
+    return 'caught'
+  finally
+    log~append('finally')
+  end
+
+::method failingTarget
+  return 1/0
+
+::method forwardsInterpreted
+  use arg log
+  do
+    interpret "forward message 'target'"
+  finally
+    log~append('finally')
+  end
+
+::method forwardsFromInternalRoutine
+  use arg log
+  do
+    call sub
+  finally
+    log~append('finally')
+  end
+  return
+  sub:
+    forward message 'target'
+
 ::method target
   use arg log
   log~append('target')
