+-- the header of the block is inside the block: an error in it runs the
+-- clause, and a CATCH clause of the same block catches it
+::method test_header_not_a_number
+  out = ''
+  do
+    do i = 1 to 'abc'
+      out = out 'no'
+    finally
+      out = out 'finally'
+    end
+  catch syntax 41.1
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+
+::method test_header_while
+  out = ''
+  do
+    do i = 1 to 3 while i/0
+      out = out 'no'
+    finally
+      out = out 'finally'
+    end
+  catch syntax 42.3
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+
+::method test_header_select_case
+  out = ''
+  do
+    select case 1/0
+      when 1 then out = out 'no'
+    finally
+      out = out 'finally'
+    end
+  catch syntax 42.3
+    out = out 'catch'
+  end
+  self~assertEquals(' finally catch', out)
+
+::method test_header_own_catch
+  out = ''
+  do i = 1 to 1/0
+    out = out 'no'
+  catch syntax
+    out = out 'catch'
+  finally
+    out = out 'finally'
+  end
+  self~assertEquals(' catch finally', out)
+
+-- the header of an inner block is evaluated each time the block starts
+::method test_header_inner_block
+  out = ''
+  do
+    do i = 1 to 2
+      do j = 1 to 1 / (2 - i)
+        out = out 'body'i
+      finally
+        out = out 'inner'i
+      end
+    finally
+      out = out 'outer'
+    end
+  catch syntax
+    out = out 'catch'
+  end
+  self~assertEquals(' body1 inner1 inner2 outer catch', out)
+
+-- a SIGNAL ON trap turns itself off when it fires, so it is already off
+-- while the clauses run on the way to its label: a second condition raised
+-- there is not trapped, and replaces the first one
+::method test_signal_on_off_in_clause
+  out = ''
+  do
+    call sub
+    out = out 'no'
+  catch syntax
+    out = out 'caller' condition('O')~code
+  end
+  self~assertEquals(' finally caller 41.1', out)
+  return
+  sub:
+    signal on syntax name trapped
+    do
+      x = 1/0
+    finally
+      out = out 'finally'
+      x = 'a' + 1
+    end
+    trapped:
+    out = out 'trapped'
+    return
+
